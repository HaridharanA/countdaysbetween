---
const now = new Date();
const currentYear = now.getFullYear();
const startOfYear = new Date(currentYear, 0, 1);

const isLeap = (currentYear % 4 === 0 && currentYear % 100 !== 0) || currentYear % 400 === 0;
const totalDaysInYear = isLeap ? 366 : 365;

const dayOfYear = Math.floor((now.getTime() - startOfYear.getTime()) / (1000 * 60 * 60 * 24)) + 1;
const daysRemaining = totalDaysInYear - dayOfYear;
const progressPercent = Math.min(100, Math.max(0, ((dayOfYear / totalDaysInYear) * 100))).toFixed(1);

const currentMonth = now.getMonth();
const currentQuarter = Math.floor(currentMonth / 3) + 1;
---

<div class="w-full mb-16 rounded-3xl p-6 md:p-8 bg-canvas border border-hairline card-shadow relative overflow-hidden" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
    <div class="flex items-center gap-3">
      <div class="h-10 w-10 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center border border-blue-500/20 flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div>
        <h3 class="font-bold text-lg text-ink">
          Progreso del Año {currentYear}
        </h3>
        <p class="text-xs text-mute font-medium">
          Día {dayOfYear} de {totalDaysInYear} &bull; Trimestre {currentQuarter} (T{currentQuarter})
        </p>
      </div>
    </div>
    <div class="text-right sm:text-right">
      <span class="text-2xl md:text-3xl font-black text-primary tabular-nums font-mono">
        {progressPercent}%
      </span>
      <p class="text-xs text-mute font-medium">{daysRemaining} días restantes hasta {currentYear + 1}</p>
    </div>
  </div>

  <!-- Progress Bar Track -->
  <div class="w-full h-3 bg-canvas-soft rounded-full overflow-hidden border border-hairline relative">
    <div 
      class="h-full bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-500 rounded-full transition-all duration-1000"
      style={`width: ${progressPercent}%;`}
    ></div>
  </div>

  <div class="mt-4 pt-3 border-t border-hairline flex flex-wrap items-center justify-between gap-2 text-xs text-mute">
    <span>Inicio: 1 de Enero, {currentYear}</span>
    <span class="font-semibold text-link">{daysRemaining} días hasta Año Nuevo {currentYear + 1}</span>
    <span>Fin: 31 de Diciembre, {currentYear}</span>
  </div>
</div>
