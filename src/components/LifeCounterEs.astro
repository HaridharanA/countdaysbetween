---
---

<section class="w-full h-full">
  <div class="rounded-3xl p-6 md:p-10 bg-canvas border border-hairline card-shadow h-full mx-auto lg:mx-0 w-full max-w-[700px] lg:max-w-none">
    <div class="text-center mb-8">
      <div class="mx-auto h-12 w-12 rounded-2xl bg-canvas-soft border border-hairline text-ink flex items-center justify-center mb-3 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-ink mb-2">¿Cuántos días has vivido?</h2>
      <p class="text-sm md:text-base text-mute">Cada día es un hito irrepetible. ¡Descubre tus hitos y días exactos en la Tierra!</p>
    </div>

    <div class="flex flex-col items-center gap-6 w-full text-center">
      <div class="w-full mx-auto max-w-[300px] lg:max-w-[400px]">
        <label for="birthday-input-es" class="block text-xs font-semibold uppercase tracking-wider text-mute mb-2" style="white-space: nowrap;">Tu Fecha de Nacimiento</label>
        <input 
          type="date" 
          id="birthday-input-es" 
          class="w-full h-12 px-4 rounded-xl border border-hairline bg-canvas-soft text-ink focus:border-link transition-all outline-none text-sm shadow-sm"
        />
      </div>

      <div id="life-stats-es" class="hidden w-full grid grid-cols-1 md:grid-cols-2 gap-4 animate-in fade-in slide-in-from-bottom-4 duration-700">
        <div class="md:col-span-2 bg-canvas-soft rounded-2xl p-6 md:p-8 text-center border border-hairline shadow-sm">
          <p class="text-mute font-mono text-xs uppercase tracking-wider mb-2">Has iluminado el planeta Tierra durante</p>
          <div id="days-lived-es" class="text-5xl md:text-6xl font-black text-primary font-mono tabular-nums">0</div>
          <p class="text-lg font-bold text-ink mt-1">días de vida</p>
          
          <div class="mt-6 pt-6 border-t border-hairline">
            <p class="text-mute text-xs mb-1 font-mono uppercase tracking-wider">Total de segundos vividos:</p>
            <div id="seconds-lived-es" class="text-2xl font-bold text-ink font-mono tabular-nums">0</div>
          </div>
        </div>

        <!-- Next Big Life Milestone Card -->
        <div class="md:col-span-2 bg-canvas rounded-xl p-5 border border-hairline text-left shadow-sm">
          <div class="flex items-center gap-2.5 mb-2">
            <div class="h-7 w-7 rounded-lg bg-canvas-soft text-ink flex items-center justify-center flex-shrink-0 border border-hairline">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.45.99-.99 1H7c-.55 0-1-.45-1-1v-2.34"/><path d="M14 14.66V17c0 .55.45.99.99 1H17c.55 0 1-.45 1-1v-2.34"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            </div>
            <h3 class="font-bold text-ink text-sm">Tu Próximo Gran Hito de Vida</h3>
          </div>
          <p id="next-milestone-text-es" class="text-sm font-semibold text-ink">
            Calculando tu próximo hito...
          </p>
          <p id="milestone-countdown-es" class="text-xs text-mute mt-1">
            ...
          </p>
        </div>

        <div class="bg-canvas rounded-xl p-5 border border-hairline text-left shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <h3 class="font-bold text-ink text-sm">Desglose Detallado</h3>
          </div>
          <ul class="space-y-1.5 text-mute text-xs font-mono">
            <li class="flex items-center justify-between"><span>Semanas:</span><span id="weeks-lived-es" class="font-bold text-ink">0</span></li>
            <li class="flex items-center justify-between"><span>Meses:</span><span id="months-lived-es" class="font-bold text-ink">0</span></li>
            <li class="flex items-center justify-between"><span>Horas:</span><span id="hours-lived-es" class="font-bold text-ink">0</span></li>
          </ul>
        </div>

        <div class="bg-canvas rounded-xl p-5 border border-hairline flex flex-col justify-center text-left shadow-sm">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-base">🌍</span>
            <h3 class="font-bold text-ink text-sm">Perspectiva Solar</h3>
          </div>
          <p id="leap-years-msg-es" class="text-mute text-xs leading-relaxed">
            ¡Elige una fecha para ver tu trayectoria!
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initLifeCounterES() {
    const birthdayInput = document.getElementById('birthday-input-es') as HTMLInputElement;
    const statsContainer = document.getElementById('life-stats-es');
    const daysDisplay = document.getElementById('days-lived-es');
    const secondsDisplay = document.getElementById('seconds-lived-es');
    const weeksDisplay = document.getElementById('weeks-lived-es');
    const monthsDisplay = document.getElementById('months-lived-es');
    const hoursDisplay = document.getElementById('hours-lived-es');
    const leapYearsMsg = document.getElementById('leap-years-msg-es');
    const nextMilestoneText = document.getElementById('next-milestone-text-es');
    const milestoneCountdown = document.getElementById('milestone-countdown-es');

    let timerInterval: number | null = null;

    function isLeapYear(year: number) {
      return (year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0);
    }

    function calculateStatsES() {
      if (!birthdayInput || !birthdayInput.value) return;
      const birthDate = new Date(birthdayInput.value + "T00:00:00");
      if (isNaN(birthDate.getTime())) return;

      const now = new Date();
      const diffMs = now.getTime() - birthDate.getTime();
      
      if (diffMs < 0) {
        if (statsContainer) statsContainer.classList.add('hidden');
        return;
      }

      if (statsContainer) statsContainer.classList.remove('hidden');

      const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      const diffWeeks = Math.floor(diffDays / 7);
      
      let months = (now.getFullYear() - birthDate.getFullYear()) * 12;
      months -= birthDate.getMonth();
      months += now.getMonth();
      if (now.getDate() < birthDate.getDate()) months--;

      const diffHours = Math.floor(diffMs / (1000 * 60 * 60));

      let leapYears = 0;
      for (let y = birthDate.getFullYear(); y <= now.getFullYear(); y++) {
        if (isLeapYear(y)) {
          const feb29 = new Date(y, 1, 29);
          if (feb29 >= birthDate && feb29 <= now) {
            leapYears++;
          }
        }
      }

      const milestoneSteps = [1000, 2500, 5000, 7500, 10000, 12500, 15000, 17500, 20000, 25000, 30000, 35000, 40000];
      const nextMilestoneDays = milestoneSteps.find(m => m > diffDays) || (Math.ceil(diffDays / 5000) * 5000);
      
      const milestoneDate = new Date(birthDate.getTime() + (nextMilestoneDays * 24 * 60 * 60 * 1000));
      const daysUntilMilestone = nextMilestoneDays - diffDays;

      if (nextMilestoneText && milestoneCountdown) {
        const formattedMilestoneDate = milestoneDate.toLocaleDateString('es-ES', {
          weekday: 'long',
          month: 'long',
          day: 'numeric',
          year: 'numeric'
        });
        nextMilestoneText.innerHTML = `Tu <span class="font-bold underline">Día nº ${nextMilestoneDays.toLocaleString('es-ES')} en la Tierra</span> será el <span class="font-bold">${formattedMilestoneDate}</span>!`;
        milestoneCountdown.innerHTML = `¡Solo quedan <strong class="text-primary font-bold">${daysUntilMilestone.toLocaleString('es-ES')} días</strong> para alcanzar este hito!`;
      }

      if (daysDisplay) daysDisplay.textContent = diffDays.toLocaleString('es-ES');
      if (weeksDisplay) weeksDisplay.textContent = diffWeeks.toLocaleString('es-ES');
      if (monthsDisplay) monthsDisplay.textContent = months.toLocaleString('es-ES');
      if (hoursDisplay) hoursDisplay.textContent = diffHours.toLocaleString('es-ES');
      
      if (leapYearsMsg) {
        leapYearsMsg.innerHTML = `¡Has presenciado <span class="font-bold text-ink">${leapYears} años bisiestos</span>! La Tierra ha completado <span class="font-bold text-ink">${(diffDays / 365.25).toFixed(1)}</span> órbitas solares desde tu nacimiento.`;
      }

      if (timerInterval) clearInterval(timerInterval);
      
      const updateSeconds = () => {
        const currentNow = new Date();
        const currentDiffSecs = Math.floor((currentNow.getTime() - birthDate.getTime()) / 1000);
        if (secondsDisplay) secondsDisplay.textContent = currentDiffSecs.toLocaleString('es-ES');
      };
      
      updateSeconds();
      timerInterval = window.setInterval(updateSeconds, 1000);
    }

    birthdayInput?.addEventListener('change', calculateStatsES);
  }

  initLifeCounterES();
  document.addEventListener('astro:page-load', initLifeCounterES);
</script>
