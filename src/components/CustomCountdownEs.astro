---
---

<div id="custom-countdown-builder-es" class="w-full mb-16 rounded-3xl p-6 md:p-10 bg-canvas border border-hairline card-shadow" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
  <div class="text-center mb-8" style="width:100%;">
    <div class="mx-auto h-12 w-12 rounded-2xl bg-canvas-soft border border-hairline text-ink flex items-center justify-center mb-3 shadow-sm">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-ink mb-2">
      Crea Tu Propia Cuenta Regresiva
    </h2>
    <p class="text-sm md:text-base text-mute">
      ¿Contando los días para unas vacaciones, boda, graduación o cumpleaños? Genera un contador en vivo gratuito y compártelo.
    </p>
  </div>

  <form id="custom-form-es" class="space-y-6" onsubmit="event.preventDefault();">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="custom-event-name-es" class="block text-xs font-semibold uppercase tracking-wider text-mute mb-2">
          Nombre del Evento
        </label>
        <input
          type="text"
          id="custom-event-name-es"
          placeholder="Ej: Viaje a Cancún, Boda de Ana, Graduación"
          required
          class="w-full h-12 px-4 rounded-xl border border-hairline bg-canvas-soft text-ink text-sm outline-none focus:border-link transition-colors"
        />
      </div>

      <div>
        <label for="custom-event-date-es" class="block text-xs font-semibold uppercase tracking-wider text-mute mb-2">
          Fecha Objetivo
        </label>
        <input
          type="date"
          id="custom-event-date-es"
          required
          class="w-full h-12 px-4 rounded-xl border border-hairline bg-canvas-soft text-ink text-sm outline-none focus:border-link transition-colors"
        />
      </div>
    </div>

    <div>
      <label class="block text-xs font-semibold uppercase tracking-wider text-mute mb-2">
        Elige un Icono
      </label>
      <div class="flex flex-wrap gap-2">
        {["🎉", "✈️", "💍", "🎓", "🎂", "🚀", "🏖️", "🎸", "👶", "🏠", "🏆", "🌟"].map((emoji, index) => (
          <button
            type="button"
            class={`emoji-btn-es h-10 w-10 text-xl rounded-xl border border-hairline bg-canvas hover:border-link transition-all flex items-center justify-center cursor-pointer ${index === 0 ? "border-link bg-link/10 scale-105" : ""}`}
            data-emoji={emoji}
          >
            {emoji}
          </button>
        ))}
      </div>
    </div>

    <button
      type="submit"
      id="create-countdown-btn-es"
      class="w-full h-14 rounded-full bg-primary text-on-primary font-bold text-base hover:opacity-90 active:scale-[0.99] transition-all shadow-md flex items-center justify-center gap-2 cursor-pointer"
    >
      <span>Generar Contador Compartible →</span>
    </button>
  </form>

  <!-- Live Generated Result Card -->
  <div id="custom-result-es" class="hidden mt-10 pt-10 border-t border-hairline animate-in fade-in slide-in-from-bottom-4 duration-500">
    <div class="p-6 md:p-8 rounded-2xl bg-canvas-soft border border-hairline text-center">
      <span id="res-icon-es" class="text-4xl block mb-2">🎉</span>
      <h3 id="res-name-es" class="text-2xl md:text-3xl font-bold text-ink mb-1">Mis Vacaciones</h3>
      <p id="res-date-str-es" class="text-sm text-mute mb-6">Objetivo: 20 de Noviembre de 2026</p>

      <!-- Live timer units -->
      <div class="grid grid-cols-4 gap-3 max-w-[450px] mx-auto mb-8">
        <div class="p-3 rounded-xl bg-canvas border border-hairline shadow-sm">
          <span id="res-days-es" class="text-2xl sm:text-3xl font-black text-primary tabular-nums font-mono">0</span>
          <span class="block text-[10px] uppercase font-mono tracking-widest text-mute">Días</span>
        </div>
        <div class="p-3 rounded-xl bg-canvas border border-hairline shadow-sm">
          <span id="res-hours-es" class="text-2xl sm:text-3xl font-black text-ink tabular-nums font-mono">0</span>
          <span class="block text-[10px] uppercase font-mono tracking-widest text-mute">Horas</span>
        </div>
        <div class="p-3 rounded-xl bg-canvas border border-hairline shadow-sm">
          <span id="res-mins-es" class="text-2xl sm:text-3xl font-black text-ink tabular-nums font-mono">0</span>
          <span class="block text-[10px] uppercase font-mono tracking-widest text-mute">Min</span>
        </div>
        <div class="p-3 rounded-xl bg-canvas border border-hairline shadow-sm">
          <span id="res-secs-es" class="text-2xl sm:text-3xl font-black text-link tabular-nums font-mono">0</span>
          <span class="block text-[10px] uppercase font-mono tracking-widest text-mute">Seg</span>
        </div>
      </div>

      <!-- Share Actions -->
      <div class="flex flex-wrap justify-center gap-3">
        <button
          type="button"
          id="copy-share-link-es"
          class="h-11 px-6 rounded-full bg-primary text-on-primary font-medium text-sm hover:opacity-90 transition-all flex items-center gap-2 shadow-sm cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
          <span id="copy-btn-text-es">Copiar Enlace del Contador</span>
        </button>

        <a
          id="whatsapp-share-btn-es"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="h-11 px-6 rounded-full bg-[#25D366] text-white font-medium text-sm hover:opacity-90 transition-all flex items-center gap-2 shadow-sm"
        >
          <span>Compartir en WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  function initCustomCountdownES() {
    const form = document.getElementById('custom-form-es') as HTMLFormElement;
    const nameInput = document.getElementById('custom-event-name-es') as HTMLInputElement;
    const dateInput = document.getElementById('custom-event-date-es') as HTMLInputElement;
    const resultBox = document.getElementById('custom-result-es');
    const emojiBtns = document.querySelectorAll('.emoji-btn-es');
    
    const resIcon = document.getElementById('res-icon-es');
    const resName = document.getElementById('res-name-es');
    const resDateStr = document.getElementById('res-date-str-es');
    const resDays = document.getElementById('res-days-es');
    const resHours = document.getElementById('res-hours-es');
    const resMins = document.getElementById('res-mins-es');
    const resSecs = document.getElementById('res-secs-es');

    const copyBtn = document.getElementById('copy-share-link-es');
    const copyText = document.getElementById('copy-btn-text-es');
    const waBtn = document.getElementById('whatsapp-share-btn-es') as HTMLAnchorElement;

    let selectedEmoji = "🎉";
    let timerId: number | null = null;

    if (dateInput && !dateInput.value) {
      const nextMonth = new Date();
      nextMonth.setDate(nextMonth.getDate() + 30);
      dateInput.value = nextMonth.toISOString().split('T')[0];
    }

    emojiBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        emojiBtns.forEach((b) => b.classList.remove('border-link', 'bg-link/10', 'scale-105'));
        btn.classList.add('border-link', 'bg-link/10', 'scale-105');
        selectedEmoji = btn.getAttribute('data-emoji') || "🎉";
      });
    });

    function startLiveCountdownES(name: string, dateStr: string, icon: string) {
      if (resIcon) resIcon.innerText = icon;
      if (resName) resName.innerText = name;
      
      const targetDate = new Date(dateStr + "T00:00:00");
      if (resDateStr) {
        resDateStr.innerText = `Fecha Objetivo: ${targetDate.toLocaleDateString('es-ES', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}`;
      }

      const shareUrl = `${window.location.origin}/es/cuenta-regresiva?event=${encodeURIComponent(name)}&date=${encodeURIComponent(dateStr)}&icon=${encodeURIComponent(icon)}`;
      
      if (waBtn) {
        waBtn.href = `https://api.whatsapp.com/send?text=${encodeURIComponent(`⏳ Cuenta regresiva para ${icon} ${name}: ${shareUrl}`)}`;
      }

      if (copyBtn) {
        copyBtn.onclick = () => {
          navigator.clipboard.writeText(shareUrl).then(() => {
            if (copyText) copyText.innerText = "¡Enlace Copiado! ✅";
            setTimeout(() => {
              if (copyText) copyText.innerText = "Copiar Enlace del Contador";
            }, 3000);
          });
        };
      }

      function tick() {
        const now = new Date().getTime();
        const diff = targetDate.getTime() - now;

        if (diff <= 0) {
          if (resDays) resDays.innerText = "0";
          if (resHours) resHours.innerText = "0";
          if (resMins) resMins.innerText = "0";
          if (resSecs) resSecs.innerText = "0";
          return;
        }

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const mins = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const secs = Math.floor((diff % (1000 * 60)) / 1000);

        if (resDays) resDays.innerText = days.toLocaleString('es-ES');
        if (resHours) resHours.innerText = String(hours).padStart(2, '0');
        if (resMins) resMins.innerText = String(mins).padStart(2, '0');
        if (resSecs) resSecs.innerText = String(secs).padStart(2, '0');
      }

      if (timerId) clearInterval(timerId);
      tick();
      timerId = window.setInterval(tick, 1000);

      resultBox?.classList.remove('hidden');
      resultBox?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    form?.addEventListener('submit', () => {
      const name = nameInput.value.trim();
      const dateStr = dateInput.value;
      if (!name || !dateStr) return;
      startLiveCountdownES(name, dateStr, selectedEmoji);
    });
  }

  initCustomCountdownES();
  document.addEventListener('astro:page-load', initCustomCountdownES);
</script>
