---
---

<section class="w-full h-full">
  <div class="rounded-3xl p-6 md:p-10 bg-canvas border border-hairline card-shadow h-full mx-auto lg:mx-0 w-full max-w-[700px] lg:max-w-none">
    <div class="text-center mb-8">
      <div class="mx-auto h-12 w-12 rounded-2xl bg-canvas-soft border border-hairline text-ink flex items-center justify-center mb-3 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
      </div>
      <h2 class="text-2xl md:text-3xl font-bold text-ink mb-2">How many days have you lived?</h2>
      <p class="text-sm md:text-base text-mute">Every single day is a milestone. Discover your exact days on Earth!</p>
    </div>

    <div class="flex flex-col items-center gap-6 w-full text-center">
      <div class="w-full mx-auto max-w-[300px] lg:max-w-[400px]">
        <label for="birthday-input" class="block text-xs font-semibold uppercase tracking-wider text-mute mb-2" style="white-space: nowrap;">Your Date of Birth</label>
        <input 
          type="date" 
          id="birthday-input" 
          class="w-full h-12 px-4 rounded-xl border border-hairline bg-canvas-soft text-ink focus:border-link transition-all outline-none text-sm shadow-sm"
        />
      </div>

      <div id="life-stats" class="hidden w-full grid grid-cols-1 md:grid-cols-2 gap-4 animate-in fade-in slide-in-from-bottom-4 duration-700">
        <div class="md:col-span-2 bg-canvas-soft rounded-2xl p-6 md:p-8 text-center border border-hairline shadow-sm">
          <p class="text-mute font-mono text-xs uppercase tracking-wider mb-2">You have graced the Earth for</p>
          <div id="days-lived" class="text-5xl md:text-6xl font-black text-primary font-mono tabular-nums">0</div>
          <p class="text-lg font-bold text-ink mt-1">days on Earth</p>
          
          <div class="mt-6 pt-6 border-t border-hairline">
            <p class="text-mute text-xs mb-1 font-mono uppercase tracking-wider">Total seconds lived:</p>
            <div id="seconds-lived" class="text-2xl font-bold text-ink font-mono tabular-nums">0</div>
          </div>
        </div>

        <!-- Next Big Life Milestone Card -->
        <div class="md:col-span-2 bg-canvas rounded-xl p-5 border border-hairline text-left shadow-sm">
          <div class="flex items-center gap-2.5 mb-2">
            <div class="h-7 w-7 rounded-lg bg-canvas-soft text-ink flex items-center justify-center flex-shrink-0 border border-hairline">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.45.99-.99 1H7c-.55 0-1-.45-1-1v-2.34"/><path d="M14 14.66V17c0 .55.45.99.99 1H17c.55 0 1-.45 1-1v-2.34"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            </div>
            <h3 class="font-bold text-ink text-sm">Your Next Big Life Milestone</h3>
          </div>
          <p id="next-milestone-text" class="text-sm font-semibold text-ink">
            Calculating your next milestone...
          </p>
          <p id="milestone-countdown" class="text-xs text-mute mt-1">
            ...
          </p>
        </div>

        <div class="bg-canvas rounded-xl p-5 border border-hairline text-left shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <h3 class="font-bold text-ink text-sm">Time Breakdown</h3>
          </div>
          <ul class="space-y-1.5 text-mute text-xs font-mono">
            <li class="flex items-center justify-between"><span>Full Weeks:</span><span id="weeks-lived" class="font-bold text-ink">0</span></li>
            <li class="flex items-center justify-between"><span>Months:</span><span id="months-lived" class="font-bold text-ink">0</span></li>
            <li class="flex items-center justify-between"><span>Hours:</span><span id="hours-lived" class="font-bold text-ink">0</span></li>
          </ul>
        </div>

        <div class="bg-canvas rounded-xl p-5 border border-hairline flex flex-col justify-center text-left shadow-sm">
          <div class="flex items-center gap-2 mb-1">
            <span class="text-base">🌍</span>
            <h3 class="font-bold text-ink text-sm">Solar Perspective</h3>
          </div>
          <p id="leap-years-msg" class="text-mute text-xs leading-relaxed">
            Pick a date to see your journey!
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const birthdayInput = document.getElementById('birthday-input') as HTMLInputElement;
  const statsContainer = document.getElementById('life-stats');
  function initLifeCounter() {
    const birthdayInput = document.getElementById('birthday-input') as HTMLInputElement;
    const statsContainer = document.getElementById('life-stats');
    const daysDisplay = document.getElementById('days-lived');
    const secondsDisplay = document.getElementById('seconds-lived');
    const weeksDisplay = document.getElementById('weeks-lived');
    const monthsDisplay = document.getElementById('months-lived');
    const hoursDisplay = document.getElementById('hours-lived');
    const leapYearsMsg = document.getElementById('leap-years-msg');
    const nextMilestoneText = document.getElementById('next-milestone-text');
    const milestoneCountdown = document.getElementById('milestone-countdown');

    if (!birthdayInput) return;

    let timerInterval: number | null = null;

    function isLeapYear(year: number) {
      return (year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0);
    }

    function calculateStats() {
      const birthDate = new Date(birthdayInput.value + "T00:00:00");
      if (isNaN(birthDate.getTime())) return;

      const now = new Date();
      const diffMs = now.getTime() - birthDate.getTime();
      
      if (diffMs < 0) {
        if (statsContainer) statsContainer.classList.add('hidden');
        return;
      }

      if (statsContainer) statsContainer.classList.remove('hidden');

      const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      const diffWeeks = Math.floor(diffDays / 7);
      
      // Monthly calculation
      let months = (now.getFullYear() - birthDate.getFullYear()) * 12;
      months -= birthDate.getMonth();
      months += now.getMonth();
      if (now.getDate() < birthDate.getDate()) months--;

      const diffHours = Math.floor(diffMs / (1000 * 60 * 60));

      // Leap years count
      let leapYears = 0;
      for (let y = birthDate.getFullYear(); y <= now.getFullYear(); y++) {
        if (isLeapYear(y)) {
          const feb29 = new Date(y, 1, 29);
          if (feb29 >= birthDate && feb29 <= now) {
            leapYears++;
          }
        }
      }

      // Milestone thresholds
      const milestoneSteps = [1000, 2500, 5000, 7500, 10000, 12500, 15000, 17500, 20000, 25000, 30000, 35000, 40000];
      const nextMilestoneDays = milestoneSteps.find(m => m > diffDays) || (Math.ceil(diffDays / 5000) * 5000);
      
      const milestoneDate = new Date(birthDate.getTime() + (nextMilestoneDays * 24 * 60 * 60 * 1000));
      const daysUntilMilestone = nextMilestoneDays - diffDays;

      if (nextMilestoneText && milestoneCountdown) {
        const formattedMilestoneDate = milestoneDate.toLocaleDateString('en-US', {
          weekday: 'long',
          month: 'long',
          day: 'numeric',
          year: 'numeric'
        });
        nextMilestoneText.innerHTML = `Your <span class="font-bold underline">${nextMilestoneDays.toLocaleString()}th Day on Earth</span> will be on <span class="font-bold">${formattedMilestoneDate}</span>!`;
        milestoneCountdown.innerHTML = `Only <strong class="text-primary font-bold">${daysUntilMilestone.toLocaleString()} days</strong> left until this milestone!`;
      }

      if (daysDisplay) daysDisplay.textContent = diffDays.toLocaleString();
      if (weeksDisplay) weeksDisplay.textContent = diffWeeks.toLocaleString();
      if (monthsDisplay) monthsDisplay.textContent = months.toLocaleString();
      if (hoursDisplay) hoursDisplay.textContent = diffHours.toLocaleString();
      
      if (leapYearsMsg) {
        leapYearsMsg.innerHTML = `You've experienced <span class="font-bold text-ink">${leapYears} leap years</span>. Earth has completed <span class="font-bold text-ink">${(diffDays / 365.25).toFixed(1)}</span> orbits since your birth date.`;
      }

      // Start live counter
      if (timerInterval) clearInterval(timerInterval);
      
      const updateSeconds = () => {
        const currentNow = new Date();
        const currentDiffSecs = Math.floor((currentNow.getTime() - birthDate.getTime()) / 1000);
        if (secondsDisplay) secondsDisplay.textContent = currentDiffSecs.toLocaleString();
      };
      
      updateSeconds();
      timerInterval = window.setInterval(updateSeconds, 1000);
    }

    birthdayInput.onchange = calculateStats;
  }

  initLifeCounter();
  document.addEventListener('astro:page-load', initLifeCounter);
</script>

<style>
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes slide-in-from-bottom-4 {
    from { transform: translateY(1rem); }
    to { transform: translateY(0); }
  }
  .animate-in {
    animation-fill-mode: both;
  }
  .fade-in {
    animation-name: fade-in;
  }
  .slide-in-from-bottom-4 {
    animation-name: slide-in-from-bottom-4;
  }
  .duration-700 {
    animation-duration: 700ms;
  }
</style>
