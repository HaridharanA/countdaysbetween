---
---

<section class="w-full h-full">
  <div class="rounded-3xl p-8 md:p-12 bg-gradient-to-br from-orange-50 to-rose-100 dark:from-slate-900 dark:to-rose-950/30 border border-orange-100/50 dark:border-rose-900/20 shadow-xl shadow-orange-200/20 h-full mx-auto lg:mx-0 w-full max-w-[700px] lg:max-w-none">
    <div class="text-center mb-10">
      <div class="mx-auto h-12 w-12 rounded-2xl bg-orange-500/10 text-orange-500 flex items-center justify-center border border-orange-500/20 mb-3 shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-rose-100 mb-4">How many days have you lived?</h2>
      <p class="text-lg text-slate-600 dark:text-rose-200/70">Every single day is a milestone. Let's see your grand total!</p>
    </div>

    <div class="flex flex-col items-center gap-8 w-full text-center">
      <div class="w-full mx-auto max-w-[300px] lg:max-w-[400px]">
        <label for="birthday-input" class="block text-sm font-medium text-slate-700 dark:text-rose-200 mb-2" style="white-space: nowrap;">When's your birthday?</label>
        <input 
          type="date" 
          id="birthday-input" 
          class="w-full h-12 px-4 rounded-xl border border-orange-200 dark:border-rose-900/50 bg-white dark:bg-slate-800 text-slate-800 dark:text-white focus:border-orange-400 dark:focus:border-rose-500 focus:ring-0 transition-all outline-none text-base shadow-sm"
        />
      </div>

      <div id="life-stats" class="hidden w-full grid grid-cols-1 md:grid-cols-2 gap-6 animate-in fade-in slide-in-from-bottom-4 duration-700">
        <div class="md:col-span-2 bg-white dark:bg-slate-800/80 backdrop-blur-sm rounded-3xl p-8 text-center border border-orange-100 dark:border-rose-900/30 shadow-sm">
          <p class="text-slate-500 dark:text-rose-200/60 font-medium mb-1 uppercase tracking-wider text-sm">You have graced the Earth for</p>
          <div id="days-lived" class="text-6xl md:text-7xl font-black text-orange-500 dark:text-rose-400 tabular-nums">0</div>
          <p class="text-2xl font-bold text-slate-700 dark:text-rose-100 mt-1">beautiful days</p>
          
          <div class="mt-8 pt-8 border-t border-orange-50 dark:border-rose-900/20">
            <p class="text-slate-500 dark:text-rose-200/60 text-sm mb-2">Total seconds lived (and counting!):</p>
            <div id="seconds-lived" class="text-3xl font-bold text-slate-800 dark:text-white tabular-nums">0</div>
          </div>
        </div>

        <!-- Next Big Life Milestone Card -->
        <div class="md:col-span-2 bg-gradient-to-r from-orange-500/10 to-rose-500/10 dark:from-orange-500/20 dark:to-rose-500/20 rounded-2xl p-6 border border-orange-200/50 dark:border-rose-800/30 text-left">
          <div class="flex items-center gap-3 mb-2">
            <div class="h-8 w-8 rounded-lg bg-orange-500/20 text-orange-600 dark:text-orange-400 flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.45.99-.99 1H7c-.55 0-1-.45-1-1v-2.34"/><path d="M14 14.66V17c0 .55.45.99.99 1H17c.55 0 1-.45 1-1v-2.34"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
            </div>
            <h3 class="font-bold text-slate-800 dark:text-rose-100 text-base">Your Next Big Life Milestone</h3>
          </div>
          <p id="next-milestone-text" class="text-sm md:text-base font-semibold text-orange-600 dark:text-rose-300">
            Calculating your next milestone...
          </p>
          <p id="milestone-countdown" class="text-xs text-slate-600 dark:text-rose-200/70 mt-1">
            ...
          </p>
        </div>

        <div class="bg-white/60 dark:bg-slate-800/40 rounded-2xl p-6 border border-orange-50 dark:border-rose-900/20 text-left">
          <div class="flex items-center gap-3 mb-3">
            <div class="h-8 w-8 rounded-lg bg-orange-500/10 text-orange-600 dark:text-orange-400 flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <h3 class="font-bold text-slate-800 dark:text-rose-100">Time Breakdown</h3>
          </div>
          <ul class="space-y-2 text-slate-600 dark:text-rose-200/70 text-sm">
            <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-orange-400"></span><span id="weeks-lived" class="font-bold text-slate-800 dark:text-white">0</span> weeks</li>
            <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-orange-400"></span><span id="months-lived" class="font-bold text-slate-800 dark:text-white">0</span> months</li>
            <li class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-orange-400"></span><span id="hours-lived" class="font-bold text-slate-800 dark:text-white">0</span> hours (approx.)</li>
          </ul>
        </div>

        <div class="bg-white/60 dark:bg-slate-800/40 rounded-2xl p-6 border border-orange-50 dark:border-rose-900/20 flex flex-col justify-center text-left">
          <div class="flex items-center gap-4 mb-3">
            <span class="text-2xl">🌍</span>
            <h3 class="font-bold text-slate-800 dark:text-rose-100">Fun Fact</h3>
          </div>
          <p id="leap-years-msg" class="text-slate-600 dark:text-rose-200/70 italic leading-relaxed text-sm">
            Pick a date to see your journey!
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const birthdayInput = document.getElementById('birthday-input') as HTMLInputElement;
  const statsContainer = document.getElementById('life-stats');
  const daysDisplay = document.getElementById('days-lived');
  const secondsDisplay = document.getElementById('seconds-lived');
  const weeksDisplay = document.getElementById('weeks-lived');
  const monthsDisplay = document.getElementById('months-lived');
  const hoursDisplay = document.getElementById('hours-lived');
  const leapYearsMsg = document.getElementById('leap-years-msg');
  const nextMilestoneText = document.getElementById('next-milestone-text');
  const milestoneCountdown = document.getElementById('milestone-countdown');

  let timerInterval: number | null = null;

  function isLeapYear(year: number) {
    return (year % 4 === 0 && year % 100 !== 0) || (year % 400 === 0);
  }

  function calculateStats() {
    const birthDate = new Date(birthdayInput.value + "T00:00:00");
    if (isNaN(birthDate.getTime())) return;

    const now = new Date();
    const diffMs = now.getTime() - birthDate.getTime();
    
    if (diffMs < 0) {
      if (statsContainer) statsContainer.classList.add('hidden');
      return;
    }

    if (statsContainer) statsContainer.classList.remove('hidden');

    const diffSecs = Math.floor(diffMs / 1000);
    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
    const diffWeeks = Math.floor(diffDays / 7);
    
    // Monthly calculation
    let months = (now.getFullYear() - birthDate.getFullYear()) * 12;
    months -= birthDate.getMonth();
    months += now.getMonth();
    if (now.getDate() < birthDate.getDate()) months--;

    const diffHours = Math.floor(diffMs / (1000 * 60 * 60));

    // Leap years count
    let leapYears = 0;
    for (let y = birthDate.getFullYear(); y <= now.getFullYear(); y++) {
      if (isLeapYear(y)) {
        const feb29 = new Date(y, 1, 29);
        if (feb29 >= birthDate && feb29 <= now) {
          leapYears++;
        }
      }
    }

    // Milestone thresholds: 1,000, 2,500, 5,000, 7,500, 10,000, 12,500, 15,000, 20,000, 25,000, 30,000
    const milestoneSteps = [1000, 2500, 5000, 7500, 10000, 12500, 15000, 17500, 20000, 25000, 30000, 35000, 40000];
    const nextMilestoneDays = milestoneSteps.find(m => m > diffDays) || (Math.ceil(diffDays / 5000) * 5000);
    
    const milestoneDate = new Date(birthDate.getTime() + (nextMilestoneDays * 24 * 60 * 60 * 1000));
    const daysUntilMilestone = nextMilestoneDays - diffDays;

    if (nextMilestoneText && milestoneCountdown) {
      const formattedMilestoneDate = milestoneDate.toLocaleDateString('en-US', {
        weekday: 'long',
        month: 'long',
        day: 'numeric',
        year: 'numeric'
      });
      nextMilestoneText.innerHTML = `Your <span class="font-black underline">${nextMilestoneDays.toLocaleString()}th Day on Earth</span> will be on <span class="font-bold">${formattedMilestoneDate}</span>!`;
      milestoneCountdown.innerHTML = `Only <strong class="text-orange-500 dark:text-rose-400 font-bold">${daysUntilMilestone.toLocaleString()} days</strong> left until you hit this epic milestone! 🎉`;
    }

    if (daysDisplay) daysDisplay.textContent = diffDays.toLocaleString();
    if (weeksDisplay) weeksDisplay.textContent = diffWeeks.toLocaleString();
    if (monthsDisplay) monthsDisplay.textContent = months.toLocaleString();
    if (hoursDisplay) hoursDisplay.textContent = diffHours.toLocaleString();
    
    if (leapYearsMsg) {
      leapYearsMsg.innerHTML = `You've seen <span class="font-bold text-orange-500 dark:text-rose-400">${leapYears}</span> leap years pass by! The Earth has completed <span class="font-bold text-orange-500 dark:text-rose-400">${(diffDays / 365.25).toFixed(1)}</span> solar orbits since you arrived. 🚀`;
    }

    // Start live counter
    if (timerInterval) clearInterval(timerInterval);
    
    const updateSeconds = () => {
      const currentNow = new Date();
      const currentDiffSecs = Math.floor((currentNow.getTime() - birthDate.getTime()) / 1000);
      if (secondsDisplay) secondsDisplay.textContent = currentDiffSecs.toLocaleString();
    };
    
    updateSeconds();
    timerInterval = window.setInterval(updateSeconds, 1000);
  }

  birthdayInput?.addEventListener('change', calculateStats);
</script>

<style>
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes slide-in-from-bottom-4 {
    from { transform: translateY(1rem); }
    to { transform: translateY(0); }
  }
  .animate-in {
    animation-fill-mode: both;
  }
  .fade-in {
    animation-name: fade-in;
  }
  .slide-in-from-bottom-4 {
    animation-name: slide-in-from-bottom-4;
  }
  .duration-700 {
    animation-duration: 700ms;
  }
</style>
