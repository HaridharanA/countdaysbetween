---
interface Props {
  label: string;
  type?: "date" | "text" | "number";
  id: string;
  value?: string;
  placeholder?: string;
  required?: boolean;
}

const { label, type = "text", id, value, placeholder, required = false } = Astro.props;
---

<div class="flex flex-col gap-xs">
  <label for={id} class="text-xs font-medium uppercase tracking-wider text-mute font-mono">
    {label}
  </label>
  <input
    type={type}
    id={id}
    name={id}
    value={value}
    placeholder={placeholder}
    required={required}
    class="h-10 rounded-sm border border-hairline bg-canvas px-sm text-sm text-ink outline-none transition-colors focus:border-ink"
  />
</div>
