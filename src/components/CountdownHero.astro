---
interface Props {
  eventName: string;
  targetDate: string;
  dayOfWeek: string;
  icon?: string;
  category?: string;
}

const { eventName, targetDate, dayOfWeek, icon = "📅", category = "Holiday" } = Astro.props;

const formattedDate = new Date(targetDate + "T00:00:00Z").toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC"
});
---

<div class="relative w-full overflow-hidden rounded-3xl border border-hairline bg-canvas p-8 md:p-12 card-shadow-lg mb-12">
  <div class="mesh-gradient absolute -right-20 -top-20 h-64 w-64 opacity-20 pointer-events-none rounded-full blur-3xl"></div>
  
  <div class="relative z-10 flex flex-col items-center text-center w-full" style="width:100%;">
    <div class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-semibold text-link border border-hairline bg-canvas-soft mb-6">
      <span>{icon}</span>
      <span>{category}</span>
    </div>

    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-ink mb-4" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
      Days Until <span class="text-link">{eventName}</span>
    </h1>

    <p class="text-lg md:text-xl text-body mb-8" style="width:100%; max-width:600px; margin-left:auto; margin-right:auto;">
      {eventName} falls on <strong class="text-ink font-semibold">{dayOfWeek}, {formattedDate}</strong>.
    </p>

    <!-- Live Countdown Grid -->
    <div 
      id="countdown-timer" 
      data-target={targetDate} 
      class="grid grid-cols-2 sm:grid-cols-4 gap-4 md:gap-6 w-full max-w-[650px] mb-8"
      style="width:100%; max-width:650px; margin-left:auto; margin-right:auto;"
    >
      <div class="flex flex-col items-center justify-center p-6 rounded-2xl bg-canvas-soft border border-hairline shadow-sm">
        <span id="timer-days" class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-primary tabular-nums">--</span>
        <span class="text-xs uppercase font-mono tracking-widest text-mute mt-2">Days</span>
      </div>
      <div class="flex flex-col items-center justify-center p-6 rounded-2xl bg-canvas-soft border border-hairline shadow-sm">
        <span id="timer-hours" class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-ink tabular-nums">--</span>
        <span class="text-xs uppercase font-mono tracking-widest text-mute mt-2">Hours</span>
      </div>
      <div class="flex flex-col items-center justify-center p-6 rounded-2xl bg-canvas-soft border border-hairline shadow-sm">
        <span id="timer-minutes" class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-ink tabular-nums">--</span>
        <span class="text-xs uppercase font-mono tracking-widest text-mute mt-2">Minutes</span>
      </div>
      <div class="flex flex-col items-center justify-center p-6 rounded-2xl bg-canvas-soft border border-hairline shadow-sm">
        <span id="timer-seconds" class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-violet tabular-nums">--</span>
        <span class="text-xs uppercase font-mono tracking-widest text-mute mt-2">Seconds</span>
      </div>
    </div>

    <div id="timer-passed-msg" class="hidden text-sm font-medium text-mute bg-canvas-soft px-6 py-2.5 rounded-full border border-hairline">
      This event has already taken place.
    </div>
  </div>
</div>

<script>
  function initCountdown() {
    const timerContainer = document.getElementById('countdown-timer');
    if (!timerContainer) return;

    const targetDateStr = timerContainer.getAttribute('data-target');
    if (!targetDateStr) return;

    const targetTime = new Date(targetDateStr + "T00:00:00").getTime();

    const daysEl = document.getElementById('timer-days');
    const hoursEl = document.getElementById('timer-hours');
    const minsEl = document.getElementById('timer-minutes');
    const secsEl = document.getElementById('timer-seconds');
    const passedMsgEl = document.getElementById('timer-passed-msg');

    function update() {
      const now = new Date().getTime();
      const difference = targetTime - now;

      if (difference <= 0) {
        if (daysEl) daysEl.innerText = "0";
        if (hoursEl) hoursEl.innerText = "0";
        if (minsEl) minsEl.innerText = "0";
        if (secsEl) secsEl.innerText = "0";
        if (passedMsgEl) passedMsgEl.classList.remove('hidden');
        return;
      }

      const days = Math.floor(difference / (1000 * 60 * 60 * 24));
      const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((difference % (1000 * 60)) / 1000);

      if (daysEl) daysEl.innerText = days.toLocaleString();
      if (hoursEl) hoursEl.innerText = String(hours).padStart(2, '0');
      if (minsEl) minsEl.innerText = String(minsEl ? minutes : 0).padStart(2, '0');
      if (secsEl) secsEl.innerText = String(seconds).padStart(2, '0');
    }

    update();
    setInterval(update, 1000);
  }

  // Initialize on load and on Astro page transitions if any
  initCountdown();
  document.addEventListener('astro:page-load', initCountdown);
</script>
