---
import Layout from "../layouts/Layout.astro";
import Calculator from "../components/Calculator.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";

const pageTitle = "Business Days Calculator — Count Working Days";
const pageDescription = "Count exact business days (Monday–Friday) between two dates. Automatically excludes weekends for payroll, HR, and project deadlines.";
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="mb-12 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <a href="/" class="text-sm text-link hover:underline mb-6 inline-block">← Back to home</a>
    <div class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold text-emerald-500 border border-emerald-200 dark:border-emerald-900/50 bg-emerald-50/50 dark:bg-emerald-950/20 mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
      <span>Business & Working Days Tool</span>
    </div>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-ink mb-4" style="width:100%;">
      Business Days Calculator — <span class="text-emerald-500">Count Working Days</span>
    </h1>
    <p class="text-lg text-body mb-8" style="width:100%; max-width:600px;">
      Count working days between any two dates. Automatically excludes Saturdays and Sundays to help you plan project milestones, sprints, and payroll periods.
    </p>
  </section>

  <section id="tool" class="mb-16 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <Calculator />
  </section>

  <!-- Informational SEO Guide -->
  <section class="mb-24 w-full prose dark:prose-invert" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="prose-content w-full" style="width:100%;">
      <h2 class="text-3xl font-bold mb-6 text-ink" style="width:100%;">How Business Days Calculation Works</h2>
      <p style="width:100%; font-size:1.05rem; line-height:1.7;">
        A <strong>business day</strong> (or working day) refers to any official workday from <strong>Monday through Friday</strong>. Saturdays and Sundays are classified as weekend days and are automatically excluded from working duration calculations. In corporate environments, calculating business days is essential for sprint planning, financial clearing, and HR compliance.
      </p>

      <h3 class="text-2xl font-semibold mt-8 mb-4 text-ink" style="width:100%;">Step-by-Step Instructions</h3>
      <ol class="list-decimal pl-6 space-y-3" style="width:100%;">
        <li><strong>Select Start Date:</strong> Enter the beginning date of your working period.</li>
        <li><strong>Select End Date:</strong> Choose your target deadline or completion date.</li>
        <li><strong>Calculate Duration:</strong> Click <em>Calculate Days</em> to view total working business days alongside total calendar days.</li>
        <li><strong>Include End Date (Optional):</strong> Toggle if the final day should be included as a full active working day.</li>
      </ol>

      <h3 class="text-2xl font-semibold mt-8 mb-4 text-ink" style="width:100%;">Average Business Days per Month (2026 Reference)</h3>
      <div class="overflow-x-auto my-6" style="width:100%;">
        <table class="w-full text-left border-collapse border border-hairline rounded-xl overflow-hidden text-sm" style="width:100%;">
          <thead>
            <tr class="bg-canvas-soft border-b border-hairline text-ink font-semibold">
              <th class="p-3 border-r border-hairline">Month</th>
              <th class="p-3 border-r border-hairline">Calendar Days</th>
              <th class="p-3 border-r border-hairline">Weekend Days</th>
              <th class="p-3">Working Business Days</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline text-body">
            <tr><td class="p-3 font-semibold border-r border-hairline">January</td><td class="p-3 border-r border-hairline">31</td><td class="p-3 border-r border-hairline">9</td><td class="p-3 font-bold text-ink">22</td></tr>
            <tr><td class="p-3 font-semibold border-r border-hairline">February</td><td class="p-3 border-r border-hairline">28</td><td class="p-3 border-r border-hairline">8</td><td class="p-3 font-bold text-ink">20</td></tr>
            <tr><td class="p-3 font-semibold border-r border-hairline">March</td><td class="p-3 border-r border-hairline">31</td><td class="p-3 border-r border-hairline">9</td><td class="p-3 font-bold text-ink">22</td></tr>
            <tr><td class="p-3 font-semibold border-r border-hairline">April</td><td class="p-3 border-r border-hairline">30</td><td class="p-3 border-r border-hairline">8</td><td class="p-3 font-bold text-ink">22</td></tr>
            <tr><td class="p-3 font-semibold border-r border-hairline">May</td><td class="p-3 border-r border-hairline">31</td><td class="p-3 border-r border-hairline">10</td><td class="p-3 font-bold text-ink">21</td></tr>
            <tr><td class="p-3 font-semibold border-r border-hairline">June</td><td class="p-3 border-r border-hairline">30</td><td class="p-3 border-r border-hairline">8</td><td class="p-3 font-bold text-ink">22</td></tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-2xl font-semibold mt-8 mb-4 text-ink" style="width:100%;">Key Applications</h3>
      <ul class="list-disc pl-6 space-y-2" style="width:100%;">
        <li><strong>Agile Sprints & Software Delivery:</strong> Estimating developer capacity over two-week (10 business day) sprints.</li>
        <li><strong>Service Level Agreements (SLAs):</strong> Measuring response windows (e.g., "resolves within 3 business days").</li>
        <li><strong>Banking & ACH Settlements:</strong> Wire transfers and check clearing operate strictly on non-weekend banking days.</li>
        <li><strong>HR & Payroll Processing:</strong> Calculating PTO accrual and active working days per pay period.</li>
      </ul>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="mb-24 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <h2 class="text-3xl font-bold mb-8 text-center text-ink" style="width:100%;">Frequently Asked Questions</h2>
    <div class="space-y-4" style="width:100%;">
      <details class="faq-accordion group p-6 rounded-2xl bg-canvas border border-hairline card-shadow cursor-pointer">
        <summary class="flex items-center justify-between font-semibold text-ink list-none">
          <span class="text-lg">Are weekends included in business days?</span>
          <span class="text-link group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="text-body leading-relaxed mt-4 pt-4 border-t border-hairline text-sm">
          No. Standard business days only count Monday, Tuesday, Wednesday, Thursday, and Friday. Saturdays and Sundays are excluded automatically.
        </p>
      </details>

      <details class="faq-accordion group p-6 rounded-2xl bg-canvas border border-hairline card-shadow cursor-pointer">
        <summary class="flex items-center justify-between font-semibold text-ink list-none">
          <span class="text-lg">Should I include the end date in the count?</span>
          <span class="text-link group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="text-body leading-relaxed mt-4 pt-4 border-t border-hairline text-sm">
          By standard convention, the start date is counted and the end date represents the deadline boundary. If your work continues through the final day, enable "Include end date" in the options.
        </p>
      </details>

      <details class="faq-accordion group p-6 rounded-2xl bg-canvas border border-hairline card-shadow cursor-pointer">
        <summary class="flex items-center justify-between font-semibold text-ink list-none">
          <span class="text-lg">Do business days include public holidays?</span>
          <span class="text-link group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="text-body leading-relaxed mt-4 pt-4 border-t border-hairline text-sm">
          Standard business day calculations automatically remove Saturdays and Sundays. Public bank holidays vary by country and region, so corporate contracts often specify whether federal holidays are excluded.
        </p>
      </details>

      <details class="faq-accordion group p-6 rounded-2xl bg-canvas border border-hairline card-shadow cursor-pointer">
        <summary class="flex items-center justify-between font-semibold text-ink list-none">
          <span class="text-lg">How many business days are in a month?</span>
          <span class="text-link group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="text-body leading-relaxed mt-4 pt-4 border-t border-hairline text-sm">
          A typical calendar month contains between 20 and 22 business days, depending on whether the month has 28, 30, or 31 total days and where weekends land.
        </p>
      </details>
    </div>
  </section>

  <!-- Related Calculators Cross-Links -->
  <RelatedCalculators current="business-days" />

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "name": "Business Days Calculator",
        "url": "https://www.countdaysbetween.com/business-days/",
        "applicationCategory": "UtilityApplication",
        "operatingSystem": "All",
        "description": pageDescription
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://www.countdaysbetween.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Business Days Calculator",
            "item": "https://www.countdaysbetween.com/business-days/"
          }
        ]
      },
      {
        "@type": "HowTo",
        "name": "How to Calculate Business Days Between Dates",
        "description": "Step-by-step instructions for calculating working business days excluding weekends.",
        "step": [
          {
            "@type": "HowToStep",
            "position": 1,
            "name": "Select Start Date",
            "text": "Enter the starting date of your project or payroll period."
          },
          {
            "@type": "HowToStep",
            "position": 2,
            "name": "Select End Date",
            "text": "Enter the completion date or deadline."
          },
          {
            "@type": "HowToStep",
            "position": 3,
            "name": "Calculate Business Days",
            "text": "View working days (Mondays to Fridays) with weekends automatically excluded."
          }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Are weekends included in business days?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No. Standard business days only count Monday, Tuesday, Wednesday, Thursday, and Friday. Saturdays and Sundays are excluded automatically."
            }
          },
          {
            "@type": "Question",
            "name": "Should I include the end date in the count?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "By standard convention, the start date is counted and the end date represents the deadline boundary. If your work continues through the final day, enable 'Include end date' in the options."
            }
          },
          {
            "@type": "Question",
            "name": "Do business days include public holidays?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Standard business day calculations automatically remove Saturdays and Sundays. Public bank holidays vary by country and region."
            }
          },
          {
            "@type": "Question",
            "name": "How many business days are in a month?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A typical calendar month contains between 20 and 22 business days, depending on month length and weekend placement."
            }
          }
        ]
      }
    ]
  })} />
</Layout>
