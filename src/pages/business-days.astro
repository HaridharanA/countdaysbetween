---
import Layout from "../layouts/Layout.astro";
import Calculator from "../components/Calculator.astro";
---

<Layout title="Business Days Calculator" description="Count how many working days are between two dates, excluding weekends.">
	<section class="mb-12 w-full">
		<a href="/" class="text-sm text-link hover:underline mb-6 inline-block">← Back to home</a>
		<h1 class="text-4xl md:text-6xl font-semibold tracking-tighter leading-tight mb-6">
			Business Days <span class="text-link">Calculator.</span>
		</h1>
		<p class="text-lg text-body max-w-2xl">
			Focus specifically on working days. Our tool automatically excludes Saturdays and Sundays to help you plan your work week.
		</p>
	</section>

	<section id="tool" class="mb-24 w-full">
		<Calculator />
	</section>

	<section class="max-w-3xl mb-24 w-full">
		<h2 class="text-2xl font-semibold mb-4">How it works</h2>
		<p class="text-body mb-8">
			The business days calculator counts the number of Mondays, Tuesdays, Wednesdays, Thursdays, and Fridays between two dates. This is particularly useful for project management, payroll calculations, and service level agreements (SLAs).
		</p>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			<div class="p-6 rounded-lg border border-hairline bg-canvas">
				<h4 class="font-semibold mb-2">Weekends Excluded</h4>
				<p class="text-sm text-body">Standard business days are Monday through Friday. Saturdays and Sundays are never counted.</p>
			</div>
			<div class="p-6 rounded-lg border border-hairline bg-canvas">
				<h4 class="font-semibold mb-2">End Date Options</h4>
				<p class="text-sm text-body">You can choose whether to include the end date in your calculation, which adds one day if it's a weekday.</p>
			</div>
		</div>
	</section>
</Layout>
