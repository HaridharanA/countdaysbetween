---
import Layout from "../layouts/Layout.astro";
import Calculator from "../components/Calculator.astro";
import { formatDateForInput } from "../utils/date";

const today = formatDateForInput(new Date());
---

<Layout title="Date Countdown Calculator" description="Calculate how many days until a future event or date.">
	<section class="mb-12 w-full">
		<a href="/" class="text-sm text-link hover:underline mb-6 inline-block">← Back to home</a>
		<h1 class="text-4xl md:text-6xl font-semibold tracking-tighter leading-tight mb-6">
			Countdown <span class="text-violet">Calculator.</span>
		</h1>
		<p class="text-lg text-body max-w-2xl">
			Find out exactly how many days are left until your next big milestone, holiday, or event.
		</p>
	</section>

	<section id="tool" class="mb-24 w-full">
		<Calculator />
	</section>

	<section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-24 w-full">
		<div class="p-6 rounded-lg border border-hairline bg-canvas flex flex-col gap-2 hover:border-link transition-colors cursor-pointer" onclick="document.getElementById('start-date').value = new Date().toISOString().split('T')[0]; document.getElementById('end-date').value = '2026-12-25'; document.getElementById('calculate-btn').click();">
			<h4 class="font-semibold">Days until Christmas</h4>
			<p class="text-sm text-body">Calculate time left for the holiday season.</p>
		</div>
		<div class="p-6 rounded-lg border border-hairline bg-canvas flex flex-col gap-2 hover:border-violet transition-colors cursor-pointer" onclick="document.getElementById('start-date').value = new Date().toISOString().split('T')[0]; document.getElementById('end-date').value = '2027-01-01'; document.getElementById('calculate-btn').click();">
			<h4 class="font-semibold">Days until New Year</h4>
			<p class="text-sm text-body">Countdown to 2027.</p>
		</div>
		<div class="p-6 rounded-lg border border-hairline bg-canvas flex flex-col gap-2 hover:border-success transition-colors cursor-pointer" onclick="document.getElementById('start-date').value = new Date().toISOString().split('T')[0]; document.getElementById('end-date').value = '2026-06-21'; document.getElementById('calculate-btn').click();">
			<h4 class="font-semibold">Days until Summer Solstice</h4>
			<p class="text-sm text-body">The longest day of the year.</p>
		</div>
	</section>
</Layout>
