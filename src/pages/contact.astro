---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Input from "../components/ui/Input.astro";
---

<Layout 
	title="Contact Us" 
	description="Have a question or feedback? Get in touch with the CountDaysBetween team.">
	<section class="max-w-2xl mb-24 w-full mx-auto">
		<div class="prose-content w-full text-center mb-12">
			<h1 class="text-4xl md:text-6xl font-semibold tracking-tighter mb-4" style="width:100%; max-width:100%">Contact Us</h1>
			<p class="text-lg text-body" style="width:100%; max-width:100%">We'd love to hear from you. Send us a message below.</p>
		</div>

		<form class="flex flex-col gap-6 bg-canvas p-8 rounded-2xl card-shadow border border-hairline">
			<div class="flex flex-col gap-2">
				<label for="name" class="text-sm font-medium text-body">Name</label>
				<Input id="name" name="name" placeholder="Your name" required />
			</div>
			<div class="flex flex-col gap-2">
				<label for="email" class="text-sm font-medium text-body">Email</label>
				<Input id="email" type="email" name="email" placeholder="your@email.com" required />
			</div>
			<div class="flex flex-col gap-2">
				<label for="message" class="text-sm font-medium text-body">Message</label>
				<textarea 
					id="message" 
					name="message" 
					rows="5" 
					placeholder="How can we help?" 
					required
					class="w-full rounded-md border border-hairline bg-canvas-soft px-4 py-2 text-sm text-ink placeholder:text-mute focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary transition-all resize-none"
				></textarea>
			</div>
			<Button type="submit" variant="primary" size="lg" class="w-full">Send Message</Button>
		</form>
	</section>
</Layout>