---
import LayoutEs from "../../../layouts/LayoutEs.astro";
import holidaysEs from "../../../data/holidays-es.json";

export async function getStaticPaths() {
  return holidaysEs.map((holiday) => ({
    params: { slug: holiday.slug },
    props: { holiday }
  }));
}

interface Props {
  holiday: (typeof holidaysEs)[0];
}

const { holiday } = Astro.props;

const formattedDate = new Date(holiday.date + "T00:00:00Z").toLocaleDateString("es-ES", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC"
});

const pageTitle = `Cuántos Días Faltan Para ${holiday.name} — Cuenta Regresiva`;
const pageDescription = `Cuenta regresiva en vivo para ${holiday.name} (${formattedDate}). Consulta cuántos días, horas y días hábiles faltan en el calendario.`;

const eventSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Event",
      "name": holiday.name,
      "startDate": holiday.date,
      "endDate": holiday.date,
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "description": holiday.description ? holiday.description.join(" ") : pageDescription
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://www.countdaysbetween.com/es/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Cuenta Regresiva",
          "item": "https://www.countdaysbetween.com/es/cuenta-regresiva/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": holiday.name,
          "item": `https://www.countdaysbetween.com/es/dias-hasta/${holiday.slug}/`
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": holiday.faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<LayoutEs title={pageTitle} description={pageDescription}>
  <!-- Breadcrumbs -->
  <div class="mb-8 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <nav class="flex items-center gap-2 text-xs font-mono text-mute">
      <a href="/es/" class="hover:text-ink transition-colors">Inicio</a>
      <span>/</span>
      <a href="/es/cuenta-regresiva/" class="hover:text-ink transition-colors">Cuenta Regresiva</a>
      <span>/</span>
      <span class="text-ink font-medium truncate">{holiday.name}</span>
    </nav>
  </div>

  <!-- Hero Section with Live Countdown -->
  <section class="mb-12 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="relative w-full overflow-hidden rounded-3xl border border-hairline bg-canvas p-8 md:p-12 card-shadow-lg mb-8">
      <div class="mesh-gradient absolute -right-20 -top-20 h-64 w-64 opacity-20 pointer-events-none rounded-full blur-3xl"></div>
      
      <div class="relative z-10 flex flex-col items-center text-center w-full" style="width:100%;">
        <div class="inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-semibold text-link border border-hairline bg-canvas-soft mb-6">
          <span>{holiday.icon}</span>
          <span>{holiday.category}</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-ink mb-4" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
          Cuántos Días Faltan Para <span class="text-link">{holiday.name}</span>
        </h1>

        <p class="text-base md:text-lg text-body mb-8" style="width:100%; max-width:600px; margin-left:auto; margin-right:auto;">
          {holiday.holidayName} se celebra en <strong class="text-ink font-semibold">{holiday.dayOfWeek}, {formattedDate}</strong>.
        </p>

        <!-- Live Countdown Grid -->
        <div 
          id="countdown-timer-es" 
          data-target={holiday.date} 
          class="grid grid-cols-2 sm:grid-cols-4 gap-4 md:gap-6 w-full max-w-[650px] mb-8"
          style="width:100%; max-width:650px; margin-left:auto; margin-right:auto;"
        >
          <div class="flex flex-col items-center justify-center p-6 rounded-2xl bg-canvas-soft border border-hairline shadow-sm">
            <span id="timer-days-es" class="text-4xl sm:text-5xl font-black tracking-tight text-primary tabular-nums">--</span>
            <span class="text-xs uppercase font-mono tracking-widest text-mute mt-2">Días</span>
          </div>
          <div class="flex flex-col items-center justify-center p-6 rounded-2xl bg-canvas-soft border border-hairline shadow-sm">
            <span id="timer-hours-es" class="text-4xl sm:text-5xl font-black tracking-tight text-ink tabular-nums">--</span>
            <span class="text-xs uppercase font-mono tracking-widest text-mute mt-2">Horas</span>
          </div>
          <div class="flex flex-col items-center justify-center p-6 rounded-2xl bg-canvas-soft border border-hairline shadow-sm">
            <span id="timer-minutes-es" class="text-4xl sm:text-5xl font-black tracking-tight text-ink tabular-nums">--</span>
            <span class="text-xs uppercase font-mono tracking-widest text-mute mt-2">Minutos</span>
          </div>
          <div class="flex flex-col items-center justify-center p-6 rounded-2xl bg-canvas-soft border border-hairline shadow-sm">
            <span id="timer-seconds-es" class="text-4xl sm:text-5xl font-black tracking-tight text-violet tabular-nums">--</span>
            <span class="text-xs uppercase font-mono tracking-widest text-mute mt-2">Segundos</span>
          </div>
        </div>

        <div id="timer-passed-msg-es" class="hidden text-sm font-medium text-mute bg-canvas-soft px-6 py-2.5 rounded-full border border-hairline">
          Este evento ya ha pasado.
        </div>
      </div>
    </div>
  </section>

  <!-- 5-Year Comparison Table -->
  <section class="mb-16 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-ink" style="width:100%;">
      Fechas de {holiday.holidayName} (2024–2028)
    </h2>
    <p class="text-sm text-body mb-6" style="width:100%;">
      Consulta los días de la semana y fechas en que cae esta celebración en otros años:
    </p>

    <div class="overflow-hidden rounded-2xl border border-hairline bg-canvas card-shadow">
      <table class="w-full text-left text-sm" style="width:100%;">
        <thead class="bg-canvas-soft border-b border-hairline text-xs uppercase font-mono text-mute">
          <tr>
            <th class="px-6 py-4">Año</th>
            <th class="px-6 py-4">Fecha Oficial</th>
            <th class="px-6 py-4">Día de la Semana</th>
            <th class="px-6 py-4 text-right">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {holiday.pastFutureDates.map((item) => (
            <tr class={item.year === holiday.year ? "bg-primary/5 font-semibold" : ""}>
              <td class="px-6 py-4 font-medium text-ink">
                {item.year}
                {item.year === holiday.year && (
                  <span class="ml-2 inline-block rounded-full bg-primary/10 px-2 py-0.5 text-xs text-primary font-mono">
                    Actual
                  </span>
                )}
              </td>
              <td class="px-6 py-4 font-mono text-body text-xs">{item.date}</td>
              <td class="px-6 py-4 text-xs font-semibold text-link">{item.dayOfWeek}</td>
              <td class="px-6 py-4 text-right text-xs text-mute">
                {item.year < holiday.year ? "Pasado" : item.year === holiday.year ? "Año Actual" : "Futuro"}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Description Section -->
  <section class="mb-16 w-full prose dark:prose-invert" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="prose-content w-full" style="width:100%;">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-6 text-ink" style="width:100%;">
        Información Sobre {holiday.holidayName}
      </h2>
      {holiday.description.map((paragraph) => (
        <p class="text-body leading-relaxed mb-4" style="width:100%;">
          {paragraph}
        </p>
      ))}
    </div>
  </section>

  <!-- FAQs in Spanish -->
  {holiday.faqs.length > 0 && (
    <section class="mb-16 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-8 text-ink" style="width:100%;">
        Preguntas Frecuentes
      </h2>
      <div class="space-y-4" style="width:100%;">
        {holiday.faqs.map((faq) => (
          <details class="group p-6 rounded-2xl bg-canvas border border-hairline card-shadow cursor-pointer">
            <summary class="flex items-center justify-between font-semibold text-ink list-none">
              <span class="text-base md:text-lg">{faq.question}</span>
              <span class="text-link group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <p class="text-body leading-relaxed mt-4 pt-4 border-t border-hairline text-sm">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </section>
  )}

  <!-- Quick Calculation Helper Link -->
  <section class="mb-16 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="p-8 rounded-3xl bg-canvas-soft border border-hairline flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="text-left" style="width:100%;">
        <h3 class="text-xl font-bold text-ink mb-1">¿Calcular otro intervalo?</h3>
        <p class="text-sm text-body">Calcula días naturales, días hábiles o semanas entre cualquier fecha.</p>
      </div>
      <a
        href="/es/#tool"
        class="flex-shrink-0 h-12 flex items-center rounded-pill bg-primary px-8 text-on-primary font-medium hover:scale-105 transition-all shadow-md"
      >
        Abrir Calculadora
      </a>
    </div>
  </section>

  <!-- Script for Live Countdown -->
  <script>
    function initCountdownES() {
      const timerContainer = document.getElementById('countdown-timer-es');
      if (!timerContainer) return;

      const targetDateStr = timerContainer.getAttribute('data-target');
      if (!targetDateStr) return;

      const targetTime = new Date(targetDateStr + "T00:00:00").getTime();

      const daysEl = document.getElementById('timer-days-es');
      const hoursEl = document.getElementById('timer-hours-es');
      const minsEl = document.getElementById('timer-minutes-es');
      const secsEl = document.getElementById('timer-seconds-es');
      const passedMsgEl = document.getElementById('timer-passed-msg-es');

      function update() {
        const now = new Date().getTime();
        const difference = targetTime - now;

        if (difference <= 0) {
          if (daysEl) daysEl.innerText = "0";
          if (hoursEl) hoursEl.innerText = "0";
          if (minsEl) minsEl.innerText = "0";
          if (secsEl) secsEl.innerText = "0";
          if (passedMsgEl) passedMsgEl.classList.remove('hidden');
          return;
        }

        const days = Math.floor(difference / (1000 * 60 * 60 * 24));
        const hours = Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((difference % (1000 * 60)) / 1000);

        if (daysEl) daysEl.innerText = days.toLocaleString('es-ES');
        if (hoursEl) hoursEl.innerText = hours.toString().padStart(2, '0');
        if (minsEl) minsEl.innerText = minutes.toString().padStart(2, '0');
        if (secsEl) secsEl.innerText = seconds.toString().padStart(2, '0');
      }

      update();
      setInterval(update, 1000);
    }

    initCountdownES();
    document.addEventListener('astro:page-load', initCountdownES);
  </script>

  <!-- Schema Markup Injection -->
  <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
</LayoutEs>
