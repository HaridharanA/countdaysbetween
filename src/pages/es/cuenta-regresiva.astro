---
import LayoutEs from "../../layouts/LayoutEs.astro";
import holidaysEs from "../../data/holidays-es.json";

const holidays2026 = holidaysEs.filter((h) => h.year === 2026);

const pageTitle = "Cuenta Regresiva para las Vacaciones y Festivos 2026";
const pageDescription = "Descubre en tiempo real cuántos días faltan para las vacaciones de verano, Semana Santa, Día de Reyes y festivos oficiales.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Cuenta Regresiva de Vacaciones y Festivos",
      "url": "https://www.countdaysbetween.com/es/cuenta-regresiva/",
      "description": "Contadores en tiempo real para las principales vacaciones y días festivos."
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://www.countdaysbetween.com/es/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Cuenta Regresiva",
          "item": "https://www.countdaysbetween.com/es/cuenta-regresiva/"
        }
      ]
    }
  ]
};
---

<LayoutEs title={pageTitle} description={pageDescription}>
  <!-- Breadcrumbs -->
  <div class="mb-8 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <nav class="flex items-center gap-2 text-xs font-mono text-mute">
      <a href="/es/" class="hover:text-ink transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-ink font-medium">Cuenta Regresiva</span>
    </nav>
  </div>

  <!-- Hero Section -->
  <section class="mb-16 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="mb-8" style="width:100%;">
      <div class="inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-semibold text-violet border border-hairline bg-canvas-soft mb-4">
        <span>🏖️</span>
        <span>Contador en Vivo</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-ink mb-4" style="width:100%;">
        Cuenta Regresiva para <span class="text-violet">Vacaciones y Festivos</span>
      </h1>
      <p class="text-base md:text-lg text-body mb-6" style="width:100%; max-width:650px;">
        Descubre cuántos días, horas y minutos exactos faltan para tus próximas vacaciones, puentes festivos y descansos de 2026.
      </p>

      <!-- Jump Chips -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono font-medium uppercase tracking-wider text-mute mr-1">Ver:</span>
        <a href="#vacaciones-destacadas" class="px-3 py-1.5 rounded-full text-xs font-semibold bg-violet/10 text-violet border border-violet/20 hover:bg-violet/20 transition-colors">
          🏖️ Vacaciones de Verano
        </a>
        <a href="#festivos-2026" class="px-3 py-1.5 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 hover:bg-primary/20 transition-colors">
          Festivos 2026 ({holidays2026.length})
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Section -->
  <section id="vacaciones-destacadas" class="mb-16 w-full scroll-mt-24" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="p-8 rounded-3xl bg-canvas border border-hairline card-shadow-lg mb-8">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-3xl">🏖️</span>
        <div>
          <h2 class="text-2xl font-bold text-ink">Vacaciones y Puentes Destacados</h2>
          <p class="text-xs text-mute">Periodos de mayor descanso del año</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="/es/dias-hasta/vacaciones-de-verano-2026/"
          class="p-5 rounded-2xl bg-canvas-soft border border-hairline hover:border-violet transition-all group card-shadow flex flex-col justify-between"
        >
          <div>
            <span class="text-xs font-mono text-mute">Verano 2026</span>
            <h3 class="text-lg font-bold text-ink group-hover:text-violet transition-colors mt-1 mb-2">
              Vacaciones de Verano 2026 ☀️
            </h3>
            <p class="text-xs text-body line-clamp-2">Comienzo oficial del periodo vacacional de verano.</p>
          </div>
          <span class="text-xs font-semibold text-violet mt-4 flex items-center gap-1">
            Ver Contador al Vivo →
          </span>
        </a>

        <a
          href="/es/dias-hasta/viernes-santo-2026/"
          class="p-5 rounded-2xl bg-canvas-soft border border-hairline hover:border-violet transition-all group card-shadow flex flex-col justify-between"
        >
          <div>
            <span class="text-xs font-mono text-mute">Primavera 2026</span>
            <h3 class="text-lg font-bold text-ink group-hover:text-violet transition-colors mt-1 mb-2">
              Semana Santa 2026 🕊️
            </h3>
            <p class="text-xs text-body line-clamp-2">El primer gran puente largo vacacional de primavera.</p>
          </div>
          <span class="text-xs font-semibold text-violet mt-4 flex items-center gap-1">
            Ver Contador al Vivo →
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 2026 Holidays Grid -->
  <section id="festivos-2026" class="mb-20 w-full scroll-mt-24" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="flex items-center justify-between mb-8 pb-4 border-b border-hairline">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-ink">Festivos 2026</h2>
        <p class="text-sm text-mute mt-1">Fechas oficiales y cuenta regresiva</p>
      </div>
      <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-bold font-mono text-primary">2026</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      {holidays2026.map((h) => (
        <a
          href={`/es/dias-hasta/${h.slug}/`}
          class="flex items-center gap-3 p-4 rounded-2xl bg-canvas border border-hairline hover:border-link transition-all group card-shadow"
        >
          <span class="text-2xl flex-shrink-0">{h.icon}</span>
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold text-sm text-ink group-hover:text-link transition-colors truncate">{h.holidayName}</h3>
            <p class="text-xs text-mute truncate">{h.dayOfWeek}, {h.date}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</LayoutEs>
