---
import LayoutEs from "../../layouts/LayoutEs.astro";
import CalculatorEs from "../../components/CalculatorEs.astro";
import holidaysEs from "../../data/holidays-es.json";

const holidays2026 = holidaysEs.filter((h) => h.year === 2026);

const pageTitle = "Calculadora de Días Hábiles — Excluir Fines de Semana y Festivos";
const pageDescription = "Calcula el número exacto de días hábiles entre dos fechas. Descuenta sábados, domingos y festivos para plazos administrativos y laborales.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Calculadora de Días Hábiles",
      "url": "https://www.countdaysbetween.com/es/dias-habiles/",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "All",
      "description": "Calculadora online de días hábiles y plazos laborales en español."
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Inicio",
          "item": "https://www.countdaysbetween.com/es/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Días Hábiles",
          "item": "https://www.countdaysbetween.com/es/dias-habiles/"
        }
      ]
    }
  ]
};
---

<LayoutEs title={pageTitle} description={pageDescription}>
  <!-- Breadcrumbs -->
  <div class="mb-8 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <nav class="flex items-center gap-2 text-xs font-mono text-mute">
      <a href="/es/" class="hover:text-ink transition-colors">Inicio</a>
      <span>/</span>
      <span class="text-ink font-medium">Días Hábiles</span>
    </nav>
  </div>

  <section class="mb-16 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="mb-8" style="width:100%;">
      <div class="inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-semibold text-link border border-hairline bg-canvas-soft mb-4">
        <span>💼</span>
        <span>Plazos Laborales y Legales</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-ink mb-4" style="width:100%;">
        Calculadora de <span class="text-link">Días Hábiles</span>
      </h1>
      <p class="text-base md:text-lg text-body" style="width:100%; max-width:650px;">
        Cuenta únicamente los días laborables de trabajo (lunes a viernes) entre dos fechas, omitiendo los fines de semana de forma automática.
      </p>
    </div>

    <!-- Main Calculator Embed -->
    <div id="tool" class="scroll-mt-24">
      <CalculatorEs />
    </div>
  </section>

  <!-- 2026 Reference Table -->
  <section class="mb-20 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-4 text-ink" style="width:100%;">
      Calendario de Festivos Principales (2026)
    </h2>
    <p class="text-sm text-body mb-6" style="width:100%;">
      Consulta los días festivos más representativos que modifican el cómputo de días hábiles en 2026:
    </p>

    <div class="overflow-hidden rounded-2xl border border-hairline bg-canvas card-shadow">
      <table class="w-full text-left text-sm" style="width:100%;">
        <thead class="bg-canvas-soft border-b border-hairline text-xs uppercase font-mono text-mute">
          <tr>
            <th class="px-6 py-4">Festivo / Celebración</th>
            <th class="px-6 py-4">Fecha Oficial</th>
            <th class="px-6 py-4">Día de la Semana</th>
            <th class="px-6 py-4 text-right">Contador</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {holidays2026.map((h) => (
            <tr>
              <td class="px-6 py-4 font-medium text-ink flex items-center gap-2">
                <span>{h.icon}</span>
                <span>{h.holidayName}</span>
              </td>
              <td class="px-6 py-4 font-mono text-xs text-body">{h.date}</td>
              <td class="px-6 py-4 text-xs text-link font-semibold">{h.dayOfWeek}</td>
              <td class="px-6 py-4 text-right">
                <a href={`/es/dias-hasta/${h.slug}/`} class="text-xs font-semibold text-link hover:underline">
                  Ver →
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</LayoutEs>
