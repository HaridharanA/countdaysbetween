---
import Layout from "../layouts/Layout.astro";
import RelatedCalculators from "../components/RelatedCalculators.astro";

const pageTitle = "Date Calculator — Add or Subtract Days, Weeks & Months";
const pageDescription = "Calculate future or past calendar dates by adding or subtracting days, weeks, months, or business days. Fast, free, and accurate date duration calculator.";
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="mb-12 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <a href="/" class="text-sm text-link hover:underline mb-6 inline-block">← Back to home</a>
    <div class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold text-link border border-hairline bg-canvas-soft mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
      <span>Date Duration & Offset Tool</span>
    </div>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-ink mb-4" style="width:100%;">
      Date Calculator: <span class="text-link">Add or Subtract Days</span>
    </h1>
    <p class="text-lg text-body mb-6" style="width:100%; max-width:600px;">
      Find the exact future or past date by adding or subtracting days, weeks, months, or working business days from any date.
    </p>

    <!-- Quick Presets -->
    <div class="flex flex-wrap items-center gap-2 pt-2">
      <span class="text-xs font-semibold uppercase tracking-wider text-mute">Quick Presets:</span>
      <button type="button" class="preset-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas border border-hairline hover:border-link text-ink transition-colors" data-op="add" data-unit="days" data-amount="30">
        +30 Days
      </button>
      <button type="button" class="preset-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas border border-hairline hover:border-link text-ink transition-colors" data-op="add" data-unit="days" data-amount="60">
        +60 Days
      </button>
      <button type="button" class="preset-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 hover:bg-primary/20 transition-colors" data-op="add" data-unit="days" data-amount="90">
        +90 Days (Visa / Legal)
      </button>
      <button type="button" class="preset-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas border border-hairline hover:border-link text-ink transition-colors" data-op="add" data-unit="days" data-amount="180">
        +180 Days
      </button>
      <button type="button" class="preset-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas border border-hairline hover:border-link text-ink transition-colors" data-op="add" data-unit="years" data-amount="1">
        +1 Year
      </button>
      <button type="button" class="preset-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas border border-hairline hover:border-link text-ink transition-colors" data-op="sub" data-unit="days" data-amount="30">
        -30 Days Ago
      </button>
      <button type="button" class="preset-btn px-3.5 py-1.5 rounded-full text-xs font-semibold bg-canvas border border-hairline hover:border-link text-ink transition-colors" data-op="sub" data-unit="days" data-amount="90">
        -90 Days Ago
      </button>
    </div>
  </section>

  <!-- Interactive Calculator Control Panel -->
  <section class="mb-16 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="p-8 md:p-10 rounded-3xl bg-canvas border border-hairline card-shadow-lg">
      <form id="date-calc-form" class="space-y-6" onsubmit="event.preventDefault();">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Starting Date -->
          <div>
            <label for="start-date-input" class="block text-xs font-semibold uppercase tracking-wider text-mute mb-2">
              Start Date
            </label>
            <input
              type="date"
              id="start-date-input"
              required
              class="w-full h-12 px-4 rounded-xl border border-hairline bg-canvas text-ink text-sm outline-none focus:border-link transition-colors shadow-sm"
            />
          </div>

          <!-- Operation Toggle (Segmented Pill) -->
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-mute mb-2">
              Operation
            </label>
            <div class="grid grid-cols-2 gap-2 p-1 rounded-xl bg-canvas-soft border border-hairline">
              <button
                type="button"
                id="btn-op-add"
                class="h-10 rounded-lg font-semibold text-xs flex items-center justify-center gap-1.5 transition-all bg-link text-white shadow-sm"
              >
                <span>Add Time (+)</span>
              </button>
              <button
                type="button"
                id="btn-op-sub"
                class="h-10 rounded-lg font-semibold text-xs flex items-center justify-center gap-1.5 transition-all text-body hover:text-ink"
              >
                <span>Subtract Time (-)</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Duration Fields in One Clean Row -->
        <div>
          <label for="input-amount" class="block text-xs font-semibold uppercase tracking-wider text-mute mb-2">
            Duration to Offset
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="relative flex items-center">
              <input
                type="number"
                id="input-amount"
                min="0"
                value="30"
                required
                placeholder="Enter amount (e.g. 30)"
                class="w-full h-12 px-4 rounded-xl border border-hairline bg-canvas text-ink text-base font-bold outline-none focus:border-link transition-colors shadow-sm"
              />
            </div>
            <div>
              <select
                id="select-unit"
                class="w-full h-12 px-4 rounded-xl border border-hairline bg-canvas text-ink text-sm font-semibold outline-none focus:border-link transition-colors shadow-sm cursor-pointer"
              >
                <option value="days">Days</option>
                <option value="weeks">Weeks</option>
                <option value="months">Months</option>
                <option value="years">Years</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Business Days Toggle -->
        <div class="flex items-center gap-3 pt-1">
          <input
            type="checkbox"
            id="checkbox-business-only"
            class="h-4 w-4 rounded border-hairline text-link focus:ring-link cursor-pointer"
          />
          <label for="checkbox-business-only" class="text-sm font-medium text-ink cursor-pointer">
            Count business days only (exclude Saturdays and Sundays)
          </label>
        </div>
      </form>

      <!-- Live Calculated Output Card -->
      <div id="calc-result-box" class="mt-8 pt-8 border-t border-hairline text-center animate-in fade-in duration-500">
        <p id="plain-english-summary" class="text-sm md:text-base font-medium text-mute mb-2">
          30 days after start date is:
        </p>
        
        <div id="result-target-date" class="text-3xl md:text-5xl font-black text-primary tracking-tight mb-2">
          --
        </div>
        <p id="result-weekday" class="text-lg font-semibold text-link mb-6">
          --
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-[650px] mx-auto text-left">
          <div class="p-4 rounded-2xl bg-canvas-soft border border-hairline">
            <span class="text-xs uppercase font-mono text-mute block mb-1">Calendar Days Span</span>
            <span id="result-span-days" class="text-xl font-bold text-ink tabular-nums">0</span>
          </div>
          <div class="p-4 rounded-2xl bg-canvas-soft border border-hairline">
            <span class="text-xs uppercase font-mono text-mute block mb-1">Day of Year</span>
            <span id="result-day-of-year" class="text-xl font-bold text-ink tabular-nums">0</span>
          </div>
          <div class="p-4 rounded-2xl bg-canvas-soft border border-hairline">
            <span class="text-xs uppercase font-mono text-mute block mb-1">Week of Year</span>
            <span id="result-week-of-year" class="text-xl font-bold text-ink tabular-nums">0</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Informational SEO Guide -->
  <section class="mb-24 w-full prose dark:prose-invert" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="prose-content w-full" style="width:100%;">
      <h2 class="text-3xl font-bold mb-6 text-ink" style="width:100%;">How to Add or Subtract Days from Any Date</h2>
      <p style="width:100%; font-size:1.05rem; line-height:1.7;">
        Using our <strong>Date Calculator</strong>, you can instantly determine a future or past date by offsetting calendar days, business days, weeks, months, or full years from any reference start date. Whether you are tracking <strong>visa 90/180 rule limits</strong>, managing legal filing deadlines, calculating pregnancy due dates, or planning project milestones, this tool computes exact calendar duration without requiring manual calendar flipping.
      </p>

      <h3 class="text-2xl font-semibold mt-8 mb-4 text-ink" style="width:100%;">Step-by-Step Instructions</h3>
      <ol class="list-decimal pl-6 space-y-3" style="width:100%;">
        <li><strong>Select your Start Date:</strong> Pick any starting point on the calendar. By default, it uses today's date.</li>
        <li><strong>Choose Operation:</strong> Toggle between <em>Add Time (+)</em> for future dates or <em>Subtract Time (-)</em> for past dates.</li>
        <li><strong>Input Duration:</strong> Enter the number of units and select Days, Weeks, Months, or Years from the dropdown menu.</li>
        <li><strong>Toggle Business Days (Optional):</strong> Check <em>"Count business days only"</em> to automatically bypass Saturdays and Sundays.</li>
        <li><strong>Read Target Date:</strong> Instantly view the formatted target date, weekday name, day-of-year index, and ISO week number.</li>
      </ol>

      <h3 class="text-2xl font-semibold mt-8 mb-4 text-ink" style="width:100%;">Worked Examples for Common Intervals</h3>
      <div class="overflow-x-auto my-6" style="width:100%;">
        <table class="w-full text-left border-collapse border border-hairline rounded-xl overflow-hidden text-sm" style="width:100%;">
          <thead>
            <tr class="bg-canvas-soft border-b border-hairline text-ink font-semibold">
              <th class="p-3 border-r border-hairline">Preset Interval</th>
              <th class="p-3 border-r border-hairline">Common Use Case</th>
              <th class="p-3">Calculation Method</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline text-body">
            <tr>
              <td class="p-3 font-semibold text-ink border-r border-hairline">+30 Days</td>
              <td class="p-3 border-r border-hairline">Invoice payment terms (Net 30), product return policy</td>
              <td class="p-3">Adds 30 consecutive calendar days</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-ink border-r border-hairline">+60 Days</td>
              <td class="p-3 border-r border-hairline">Tenant notice periods, contract renewal warnings</td>
              <td class="p-3">Adds 60 consecutive calendar days</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-ink border-r border-hairline">+90 Days</td>
              <td class="p-3 border-r border-hairline">Schengen tourist visa stays, corporate probation reviews</td>
              <td class="p-3">Adds 90 consecutive calendar days</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-ink border-r border-hairline">+180 Days</td>
              <td class="p-3 border-r border-hairline">Semi-annual financial reporting, passport validity rules</td>
              <td class="p-3">Adds 180 consecutive calendar days</td>
            </tr>
            <tr>
              <td class="p-3 font-semibold text-ink border-r border-hairline">+280 Days (40 Weeks)</td>
              <td class="p-3 border-r border-hairline">Obstetric pregnancy estimated due date (EDD)</td>
              <td class="p-3">Adds 280 calendar days from last menstrual period</td>
            </tr>
          </tbody>
        </table>
      </div>

      <h3 class="text-2xl font-semibold mt-8 mb-4 text-ink" style="width:100%;">Calendar Days vs. Working Business Days</h3>
      <p style="width:100%;">
        Standard calendar calculations include every day of the week (Monday through Sunday, plus leap days). When measuring project deadlines or banking settlements, selecting <em>"Count business days only"</em> iterates exclusively through Mondays, Tuesdays, Wednesdays, Thursdays, and Fridays. For instance, adding 10 business days to a Monday lands 14 calendar days later on the second Monday, successfully skipping 4 weekend days.
      </p>
    </div>
  </section>

  <!-- Related Calculators Cross-Links -->
  <RelatedCalculators current="date-calc" />

  <!-- FAQ Section -->
  <section class="mb-24 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <h2 class="text-3xl font-bold mb-8 text-center text-ink" style="width:100%;">Frequently Asked Questions</h2>
    <div class="space-y-4" style="width:100%;">
      <details class="faq-accordion group p-6 rounded-2xl bg-canvas border border-hairline card-shadow cursor-pointer">
        <summary class="flex items-center justify-between font-semibold text-ink list-none">
          <span class="text-lg">What date is 90 days from today?</span>
          <span class="text-link group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="text-body leading-relaxed mt-4 pt-4 border-t border-hairline text-sm">
          Click the "+90 Days" quick preset above to instantly see the exact date, weekday, and week number 90 days into the future starting from today.
        </p>
      </details>

      <details class="faq-accordion group p-6 rounded-2xl bg-canvas border border-hairline card-shadow cursor-pointer">
        <summary class="flex items-center justify-between font-semibold text-ink list-none">
          <span class="text-lg">How does leap year affect adding a full year (365 days)?</span>
          <span class="text-link group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="text-body leading-relaxed mt-4 pt-4 border-t border-hairline text-sm">
          A standard calendar year has 365 days, whereas leap years contain 366 days (including February 29th). If your interval crosses a leap day, adding 365 calendar days will fall on the day before the same date next year, while adding "1 Year" lands on the identical calendar date.
        </p>
      </details>

      <details class="faq-accordion group p-6 rounded-2xl bg-canvas border border-hairline card-shadow cursor-pointer">
        <summary class="flex items-center justify-between font-semibold text-ink list-none">
          <span class="text-lg">Can I add working business days only?</span>
          <span class="text-link group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="text-body leading-relaxed mt-4 pt-4 border-t border-hairline text-sm">
          Yes. Toggle the "Count business days only" checkbox. The calculator will advance day-by-day and exclude all Saturdays and Sundays automatically.
        </p>
      </details>
    </div>
  </section>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "name": "Date Calculator — Add or Subtract Days",
        "url": "https://www.countdaysbetween.com/date-calculator/",
        "applicationCategory": "UtilityApplication",
        "operatingSystem": "All",
        "description": pageDescription
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://www.countdaysbetween.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Date Calculator",
            "item": "https://www.countdaysbetween.com/date-calculator/"
          }
        ]
      },
      {
        "@type": "HowTo",
        "name": "How to Add or Subtract Days from Any Date",
        "description": "Step-by-step instructions for calculating past or future dates by offsetting days, weeks, months, or business days.",
        "step": [
          {
            "@type": "HowToStep",
            "position": 1,
            "name": "Select Start Date",
            "text": "Choose your starting reference date on the calendar."
          },
          {
            "@type": "HowToStep",
            "position": 2,
            "name": "Choose Operation",
            "text": "Toggle Add Time (+) for future dates or Subtract Time (-) for past dates."
          },
          {
            "@type": "HowToStep",
            "position": 3,
            "name": "Set Duration & Units",
            "text": "Type the number of offset units and select Days, Weeks, Months, or Years."
          },
          {
            "@type": "HowToStep",
            "position": 4,
            "name": "View Target Date",
            "text": "Read the exact calculated target date, day of the week, and ISO week number."
          }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What date is 90 days from today?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Click the '+90 Days' quick preset above to instantly see the exact date, weekday, and week number 90 days into the future starting from today."
            }
          },
          {
            "@type": "Question",
            "name": "How does leap year affect adding a full year (365 days)?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A standard calendar year has 365 days, whereas leap years contain 366 days (including February 29th). If your interval crosses a leap day, adding 365 calendar days will fall on the day before the same date next year, while adding '1 Year' lands on the identical calendar date."
            }
          },
          {
            "@type": "Question",
            "name": "Can I add working business days only?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Toggle the 'Count business days only' checkbox. The calculator will advance day-by-day and exclude all Saturdays and Sundays automatically."
            }
          }
        ]
      }
    ]
  })} />
</Layout>

<script>
  function setupDateCalc() {
    const startDateInput = document.getElementById('start-date-input') as HTMLInputElement;
    const btnAdd = document.getElementById('btn-op-add') as HTMLButtonElement;
    const btnSub = document.getElementById('btn-op-sub') as HTMLButtonElement;
    const inputAmount = document.getElementById('input-amount') as HTMLInputElement;
    const selectUnit = document.getElementById('select-unit') as HTMLSelectElement;
    const checkBizOnly = document.getElementById('checkbox-business-only') as HTMLInputElement;
    const presetBtns = document.querySelectorAll('.preset-btn');

    const plainEnglishSummary = document.getElementById('plain-english-summary');
    const resTarget = document.getElementById('result-target-date');
    const resWeekday = document.getElementById('result-weekday');
    const resSpan = document.getElementById('result-span-days');
    const resDayOfYear = document.getElementById('result-day-of-year');
    const resWeekOfYear = document.getElementById('result-week-of-year');

    let currentOp = "add";

    if (startDateInput && !startDateInput.value) {
      startDateInput.value = new Date().toISOString().split('T')[0];
    }

    function setOp(op: string) {
      currentOp = op;
      if (op === "add") {
        btnAdd?.classList.remove('text-body', 'hover:text-ink');
        btnAdd?.classList.add('bg-link', 'text-white', 'shadow-sm');
        btnSub?.classList.remove('bg-link', 'text-white', 'shadow-sm');
        btnSub?.classList.add('text-body', 'hover:text-ink');
      } else {
        btnSub?.classList.remove('text-body', 'hover:text-ink');
        btnSub?.classList.add('bg-link', 'text-white', 'shadow-sm');
        btnAdd?.classList.remove('bg-link', 'text-white', 'shadow-sm');
        btnAdd?.classList.add('text-body', 'hover:text-ink');
      }
      calculate();
    }

    btnAdd?.addEventListener('click', () => setOp('add'));
    btnSub?.addEventListener('click', () => setOp('sub'));

    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const op = btn.getAttribute('data-op') || "add";
        const unit = btn.getAttribute('data-unit') || "days";
        const amount = parseInt(btn.getAttribute('data-amount') || "30");
        if (inputAmount) inputAmount.value = String(amount);
        if (selectUnit) selectUnit.value = unit;
        if (checkBizOnly) checkBizOnly.checked = false;
        setOp(op);
      });
    });

    function calculate() {
      if (!startDateInput || !startDateInput.value) return;
      const [year, month, day] = startDateInput.value.split('-').map(Number);
      let target = new Date(Date.UTC(year, month - 1, day));
      const amount = parseInt(inputAmount?.value || "0") || 0;
      const unit = selectUnit?.value || "days";
      const bizOnly = checkBizOnly?.checked || false;

      const sign = currentOp === "add" ? 1 : -1;

      if (bizOnly) {
        let totalDays = amount;
        if (unit === "weeks") totalDays = amount * 5;
        if (unit === "months") totalDays = amount * 21;
        if (unit === "years") totalDays = amount * 260;

        let counted = 0;
        while (counted < totalDays) {
          target.setUTCDate(target.getUTCDate() + sign);
          const dow = target.getUTCDay();
          if (dow !== 0 && dow !== 6) {
            counted++;
          }
        }
      } else {
        if (unit === "days") {
          target.setUTCDate(target.getUTCDate() + (sign * amount));
        } else if (unit === "weeks") {
          target.setUTCDate(target.getUTCDate() + (sign * amount * 7));
        } else if (unit === "months") {
          target.setUTCMonth(target.getUTCMonth() + (sign * amount));
        } else if (unit === "years") {
          target.setUTCFullYear(target.getUTCFullYear() + (sign * amount));
        }
      }

      const formatted = target.toLocaleDateString('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric',
        timeZone: 'UTC'
      });
      const weekdayStr = target.toLocaleDateString('en-US', {
        weekday: 'long',
        timeZone: 'UTC'
      });

      const startUtc = new Date(Date.UTC(year, month - 1, day));
      const diffDays = Math.round(Math.abs((target.getTime() - startUtc.getTime()) / (1000 * 60 * 60 * 24)));

      const startOfYear = new Date(Date.UTC(target.getUTCFullYear(), 0, 1));
      const dayOfYear = Math.floor((target.getTime() - startOfYear.getTime()) / (1000 * 60 * 60 * 24)) + 1;
      const weekOfYear = Math.ceil(dayOfYear / 7);

      const startFormatted = startUtc.toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        timeZone: 'UTC'
      });

      if (plainEnglishSummary) {
        const opWord = currentOp === "add" ? "after" : "before";
        plainEnglishSummary.innerText = `${amount} ${unit} ${opWord} ${startFormatted} is:`;
      }
      if (resTarget) resTarget.innerText = formatted;
      if (resWeekday) resWeekday.innerText = `Falls on a ${weekdayStr}`;
      if (resSpan) resSpan.innerText = `${diffDays.toLocaleString()} calendar days`;
      if (resDayOfYear) resDayOfYear.innerText = `Day ${dayOfYear} of ${target.getUTCFullYear()}`;
      if (resWeekOfYear) resWeekOfYear.innerText = `Week ${weekOfYear}`;
    }

    [startDateInput, inputAmount, selectUnit, checkBizOnly].forEach((el) => {
      el?.addEventListener('input', calculate);
      el?.addEventListener('change', calculate);
    });

    calculate();
  }

  setupDateCalc();
  document.addEventListener('astro:page-load', setupDateCalc);
</script>
