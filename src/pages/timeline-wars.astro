<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Timeline Wars - Fix History</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --space-blue: #00d4ff;
            --tech-green: #00ff88;
            --music-purple: #a855f7;
            --movies-orange: #ff8800;
            --sports-gold: #ffd700;
            --history-red: #ff4444;
            --science-cyan: #50e3c2;
            --indigo-accent: rgba(99,102,241,0.5);
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100vh;
            overflow-x: hidden;
            background-color: #050508;
            color: white;
            font-family: 'Inter', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        /* --- BACKGROUND & PARTICLES --- */
        #bg-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: linear-gradient(135deg, #050508 0%, #0a0a1f 50%, #050508 100%);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .star {
            position: absolute;
            background: white;
            border-radius: 50%;
            opacity: 0.5;
            animation: twinkle var(--duration) infinite ease-in-out;
        }

        @keyframes twinkle {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.2); }
        }

        /* --- UI COMPONENTS --- */
        #game-container {
            width: 100%;
            max-width: 900px;
            margin: 0 auto;
            padding: 24px;
            box-sizing: border-box;
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            gap: 16px;
            min-height: 100vh;
        }

        header {
            text-align: center;
            position: relative;
        }

        h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(2rem, 8vw, 3.5rem);
            font-weight: 900;
            font-style: italic;
            margin: 0;
            background: linear-gradient(to bottom, #fff, var(--space-blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 15px rgba(0, 212, 255, 0.5));
            letter-spacing: 2px;
        }

        .subtitle {
            font-size: 0.9rem;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 4px;
            margin-top: 5px;
        }

        .back-btn {
            position: absolute;
            top: 0;
            left: 0;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #aaa;
            padding: 10px 20px;
            border-radius: 20px;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 700;
            transition: all 0.3s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .back-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border-color: var(--space-blue);
        }

        /* --- STATS BAR --- */
        .stats-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
            padding: 20px 30px;
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .lives {
            display: flex;
            gap: 8px;
            font-size: 1.8rem;
        }

        .heart { transition: transform 0.3s; }
        .heart.beat { animation: heartbeat 0.8s ease; }

        @keyframes heartbeat {
            0% { transform: scale(1); }
            15% { transform: scale(1.3); }
            30% { transform: scale(1); }
            45% { transform: scale(1.3); }
            70% { transform: scale(1); }
        }

        .score-container { text-align: center; }
        .score-label { font-size: 0.75rem; text-transform: uppercase; color: #666; letter-spacing: 2px; }
        .score-value { font-family: 'Orbitron', sans-serif; font-size: 2.2rem; font-weight: 700; color: var(--space-blue); }

        .streak-badge {
            font-family: 'Orbitron', sans-serif;
            background: linear-gradient(45deg, #f97316, #ef4444);
            padding: 6px 16px;
            border-radius: 14px;
            font-weight: 900;
            font-size: 1rem;
            opacity: 0;
            transform: scale(0.8);
            transition: all 0.3s;
        }
        .streak-badge.active { opacity: 1; transform: scale(1); }

        /* --- TIMER --- */
        .timer-container {
            width: 100%;
            height: 8px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 4px;
            overflow: hidden;
            position: relative;
        }

        #timer-bar {
            height: 100%;
            width: 100%;
            background: #22c55e;
            transition: width 0.1s linear, background-color 0.5s;
        }
        #timer-bar.warning { background-color: #eab308; }
        #timer-bar.critical { 
            background-color: #ef4444; 
            animation: timerPulse 0.5s infinite;
        }
        @keyframes timerPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }

        /* --- SLOTS --- */
        .slots-label {
            text-align: center;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            letter-spacing: 3px;
            color: var(--space-blue);
            font-weight: 700;
            margin-bottom: -10px;
        }

        #slots-container {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 12px;
            margin: 24px 0;
        }

        .slot {
            min-height: 120px;
            background: rgba(99, 102, 241, 0.15);
            border: 2px dashed rgba(99, 102, 241, 0.6);
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
            padding: 16px;
            font-family: 'Orbitron', sans-serif;
            font-size: 36px;
            color: rgba(99, 102, 241, 0.6);
        }

        .slot:hover {
            background: rgba(99, 102, 241, 0.2);
            border-color: rgba(99, 102, 241, 0.8);
            transform: scale(1.02);
        }

        .slot-number {
            font-family: 'Orbitron', sans-serif;
            font-size: 36px;
            font-weight: 900;
            color: rgba(99, 102, 241, 0.6);
            pointer-events: none;
        }

        .slot.drag-over {
            background: rgba(0, 255, 136, 0.1);
            border-color: var(--tech-green);
        }

        .slot.occupied {
            border-style: solid;
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.1);
            padding: 0;
        }

        .motivation-msg {
            text-align: center;
            font-size: 0.9rem;
            color: #555;
            font-style: italic;
        }

        /* --- CARDS --- */
        #cards-pool, #cards-area {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
            margin: 24px 0;
            justify-content: center;
        }

        .event-card {
            background: rgba(255, 255, 255, 0.07);
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 20px 24px;
            min-height: 90px;
            display: flex;
            align-items: center;
            gap: 16px;
            cursor: grab;
            transition: all 0.3s;
            user-select: none;
            box-sizing: border-box;
        }
        .event-card:active { cursor: grabbing; }

        .event-card:hover {
            transform: translateY(-3px);
            background: rgba(255, 255, 255, 0.12);
        }

        .event-card.selected {
            border-color: var(--space-blue);
            background: rgba(0, 212, 255, 0.1);
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
            transform: scale(1.03);
        }

        .card-emoji { font-size: 2rem; flex-shrink: 0; }

        .card-info { flex: 1; min-width: 0; text-align: left; }
        .card-name { font-weight: 700; font-size: 18px; margin-bottom: 4px; color: #eee; }
        .card-hint { font-size: 13px; color: #777; text-transform: uppercase; letter-spacing: 1px; }

        /* --- CATEGORY COLORS --- */
        .cat-space { border-left-color: var(--space-blue); }
        .cat-tech { border-left-color: var(--tech-green); }
        .cat-music { border-left-color: var(--music-purple); }
        .cat-movies { border-left-color: var(--movies-orange); }
        .cat-sports { border-left-color: var(--sports-gold); }
        .cat-history { border-left-color: var(--history-red); }
        .cat-science { border-left-color: var(--science-cyan); }

        /* --- ACTION BUTTONS --- */
        #fix-btn {
            font-family: 'Orbitron', sans-serif;
            width: 100%;
            padding: 24px;
            background: linear-gradient(to right, #2563eb, var(--space-blue));
            color: white;
            font-size: 1.8rem;
            font-weight: 900;
            border: none;
            border-radius: 15px;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 6px;
            display: none;
            box-shadow: 0 0 30px rgba(37, 99, 235, 0.4);
        }

        /* --- OVERLAYS --- */
        .overlay {
            position: fixed;
            inset: 0;
            background: rgba(5, 5, 8, 0.98);
            backdrop-filter: blur(20px);
            z-index: 1000;
            display: none; /* Changed from opacity 0 to display none for the tutorial fix */
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px;
            text-align: center;
        }
        .overlay.active { display: flex; }

        .overlay-title {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(2.5rem, 10vw, 4rem);
            font-weight: 900;
            font-style: italic;
            margin-bottom: 20px;
        }

        .overlay-btn {
            font-family: 'Orbitron', sans-serif;
            padding: 20px 40px;
            font-size: 1.2rem;
            font-weight: 700;
            border-radius: 12px;
            cursor: pointer;
            border: none;
            text-transform: uppercase;
            transition: transform 0.2s;
            text-decoration: none;
        }
        .overlay-btn:hover { transform: scale(1.05); }

        .next-mission-btn { background: white; color: black; }
        .restart-btn { background: var(--history-red); color: white; margin-bottom: 15px; }
        .home-btn { background: rgba(255,255,255,0.1); color: white; border: 1px solid rgba(255,255,255,0.2); }

        .step { display: flex; align-items: center; gap: 20px; text-align: left; margin-bottom: 20px; width: 100%; max-width: 400px; }
        .step-icon { font-size: 1.5rem; background: rgba(255,255,255,0.05); width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; border-radius: 50%; }

        /* --- MOBILE --- */
        @media (max-width: 600px) {
            #slots-container { grid-template-columns: repeat(3, 1fr); }
            .slot { min-height: 100px; }
        }
    </style>
</head>
<body>

    <div id="bg-canvas"></div>

    <!-- INTRO OVERLAY -->
    <div id="intro-screen" class="overlay active" style="display: flex;">
        <h1 class="overlay-title">TIMELINE WARS</h1>
        <div style="margin-bottom: 40px;">
            <div class="step"><div class="step-icon">📅</div><div><strong>PICK</strong> a historical event from the pool.</div></div>
            <div class="step"><div class="step-icon">📥</div><div><strong>PLACE</strong> it into the timeline chronologically.</div></div>
            <div class="step"><div class="step-icon">⚡</div><div><strong>FIX</strong> history before time runs out!</div></div>
        </div>
        <button class="overlay-btn next-mission-btn" onclick="closeIntro()">BEGIN MISSION 🚀</button>
    </div>

    <!-- MAIN GAME -->
    <div id="game-container">
        <header>
            <a href="/" style="position:fixed; top:20px; left:20px; background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); color:white; padding:10px 20px; border-radius:50px; text-decoration:none; font-family:Inter,sans-serif; font-size:14px; z-index:9999;">← BACK</a>
            <h1>TIMELINE WARS</h1>
            <div class="subtitle">Arrange history. Fix the timeline.</div>
        </header>

        <div class="stats-bar">
            <div id="lives-display" class="lives">
                <span class="heart">❤️</span><span class="heart">❤️</span><span class="heart">❤️</span>
            </div>
            <div class="score-container">
                <div class="score-label">Current Score</div>
                <div id="score-display" class="score-value">000,000</div>
            </div>
            <div id="streak-badge" class="streak-badge">🔥 x0</div>
        </div>

        <div class="timer-container"><div id="timer-bar"></div></div>

        <div class="slots-label">ARRANGE IN ORDER: OLDEST → NEWEST</div>
        
        <div id="slots-container" style="display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin:24px 0;">
            <div class="slot" data-slot="0" style="min-height:120px; background:rgba(99,102,241,0.15); border:2px dashed rgba(99,102,241,0.6); border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:36px; color:rgba(99,102,241,0.6); cursor:pointer; font-family:Orbitron,sans-serif;">1</div>
            <div class="slot" data-slot="1" style="min-height:120px; background:rgba(99,102,241,0.15); border:2px dashed rgba(99,102,241,0.6); border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:36px; color:rgba(99,102,241,0.6); cursor:pointer; font-family:Orbitron,sans-serif;">2</div>
            <div class="slot" data-slot="2" style="min-height:120px; background:rgba(99,102,241,0.15); border:2px dashed rgba(99,102,241,0.6); border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:36px; color:rgba(99,102,241,0.6); cursor:pointer; font-family:Orbitron,sans-serif;">3</div>
            <div class="slot" data-slot="3" style="min-height:120px; background:rgba(99,102,241,0.15); border:2px dashed rgba(99,102,241,0.6); border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:36px; color:rgba(99,102,241,0.6); cursor:pointer; font-family:Orbitron,sans-serif;">4</div>
            <div class="slot" data-slot="4" style="min-height:120px; background:rgba(99,102,241,0.15); border:2px dashed rgba(99,102,241,0.6); border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:36px; color:rgba(99,102,241,0.6); cursor:pointer; font-family:Orbitron,sans-serif;">5</div>
        </div>

        <div style="border-top:1px solid rgba(255,255,255,0.1); margin:8px 0; position:relative;">
            <span style="position:absolute; top:-12px; left:50%; transform:translateX(-50%); background:#0a0a0f; padding:0 16px; color:rgba(255,255,255,0.4); font-size:12px; font-family:Inter,sans-serif;">SELECT A CARD BELOW</span>
        </div>

        <div id="cards-area" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(280px,1fr)); gap:16px; margin:24px 0;"></div>

        <div class="action-area">
            <button id="fix-btn" onclick="checkTimeline()">FIX TIMELINE ⚡</button>
        </div>
    </div>

    <!-- ROUND COMPLETE -->
    <div id="round-overlay" class="overlay">
        <div class="overlay-title" style="color:var(--tech-green)">TIMELINE RESTORED! ✅</div>
        <div id="round-stats" style="margin-bottom: 30px; font-size: 1.2rem;"></div>
        <div id="fact-box" style="background:rgba(255,255,255,0.05); padding:20px; border-radius:15px; margin-bottom:30px; max-width:500px;">
            <div style="color:var(--space-blue); font-size:0.7rem; font-family:Orbitron; margin-bottom:10px;">HISTORICAL RECORD</div>
            <div id="fact-text" style="font-style:italic;"></div>
        </div>
        <button class="overlay-btn next-mission-btn" onclick="startRound()">NEXT MISSION →</button>
    </div>

    <!-- GAME OVER -->
    <div id="over-overlay" class="overlay">
        <div class="overlay-title" style="color:var(--history-red)">TIMELINE LOST 💀</div>
        <div style="background:rgba(255,255,255,0.05); padding:30px; border-radius:24px; margin-bottom:40px; width:300px;">
            <div class="score-label">Final Score</div>
            <div id="final-score" style="font-size:3rem; font-family:Orbitron; color:var(--space-blue);">0</div>
        </div>
        <button class="overlay-btn restart-btn" onclick="location.reload()">TRY AGAIN 🔄</button>
        <a href="/" class="overlay-btn home-btn">← BACK TO HOME</a>
    </div>

    <script is:inline>
        const CATEGORIES = {
            space: { emoji: "🚀", class: "cat-space" },
            tech: { emoji: "💻", class: "cat-tech" },
            music: { emoji: "🎵", class: "cat-music" },
            movies: { emoji: "🎬", class: "cat-movies" },
            sports: { emoji: "🏆", class: "cat-sports" },
            history: { emoji: "⚔️", class: "cat-history" },
            science: { emoji: "🔬", class: "cat-science" }
        };

        const ALL_EVENTS = [
            { id: 's1', name: 'Moon Landing', year: 1969, cat: 'space', hint: 'One giant leap...' },
            { id: 's2', name: 'Sputnik Launch', year: 1957, cat: 'space', hint: 'Beep beep from orbit' },
            { id: 's3', name: 'Mars Curiosity', year: 2012, cat: 'space', hint: 'Red planet explored' },
            { id: 't1', name: 'First iPhone', year: 2007, cat: 'tech', hint: 'Steve said one more thing' },
            { id: 't2', name: 'WWW Invented', year: 1991, cat: 'tech', hint: 'The internet is born' },
            { id: 't3', name: 'Google Founded', year: 1998, cat: 'tech', hint: "Don't be evil" },
            { id: 'm1', name: 'Thriller Album', year: 1982, cat: 'music', hint: 'Best selling ever' },
            { id: 'm2', name: 'Woodstock', year: 1969, cat: 'music', hint: '3 days of peace' },
            { id: 'v1', name: 'Star Wars', year: 1977, cat: 'movies', hint: 'A long time ago...' },
            { id: 'v2', name: 'Titanic Film', year: 1997, cat: 'movies', hint: "King of the world" },
            { id: 'sp1', name: 'First Super Bowl', year: 1967, cat: 'sports', hint: "Football's big day" },
            { id: 'sp2', name: 'Jordan Last Ring', year: 1998, cat: 'sports', hint: 'The last dance' },
            { id: 'h1', name: 'WWI Begins', year: 1914, cat: 'history', hint: 'War to end all wars' },
            { id: 'h2', name: 'Berlin Wall Falls', year: 1989, cat: 'history', hint: 'Tear down this wall' },
            { id: 'sc1', name: 'DNA Structure', year: 1953, cat: 'science', hint: 'Secret of life' },
            { id: 'sc2', name: 'Penicillin', year: 1928, cat: 'science', hint: 'Mold saves millions' }
        ];

        let state = {
            score: 0, lives: 3, streak: 0, round: 1, timer: 30, timerInterval: null,
            currentEvents: [], placedEvents: [null, null, null, null, null], selectedCard: null
        };

        function init() {
            createStars();
            setupSlotListeners();
            // Issue 1: Tutorial logic. Always show if not specifically hidden by session
            if (sessionStorage.getItem('timeline_tutorial_done')) {
                closeIntro();
            }
        }

        function setupSlotListeners() {
            const slots = document.querySelectorAll('.slot');
            slots.forEach((s, i) => {
                s.onclick = () => handleSlotClick(i);
                s.ondragover = (e) => { e.preventDefault(); s.classList.add('drag-over'); };
                s.ondragleave = () => s.classList.remove('drag-over');
                s.ondrop = (e) => {
                    e.preventDefault(); s.classList.remove('drag-over');
                    const id = e.dataTransfer.getData('text/plain');
                    const event = state.currentEvents.find(ev => ev.id === id);
                    if (event) placeEvent(event, i);
                };
            });
        }

        function createStars() {
            const bg = document.getElementById('bg-canvas');
            for(let i=0; i<80; i++) {
                const s = document.createElement('div');
                s.className = 'star';
                s.style.left = Math.random() * 100 + '%';
                s.style.top = Math.random() * 100 + '%';
                s.style.width = Math.random() * 2 + 1 + 'px';
                s.style.height = s.style.width;
                s.style.setProperty('--duration', Math.random() * 3 + 2 + 's');
                bg.appendChild(s);
            }
        }

        function closeIntro() {
            document.getElementById('intro-screen').classList.remove('active');
            document.getElementById('intro-screen').style.display = 'none';
            sessionStorage.setItem('timeline_tutorial_done', 'true');
            startRound();
        }

        function startRound() {
            state.timer = 30;
            state.placedEvents = [null, null, null, null, null];
            state.selectedCard = null;
            document.getElementById('round-overlay').classList.remove('active');
            selectEvents();
            renderSlots();
            renderPool();
            startTimer();
            updateUI();
        }

        function selectEvents() {
            state.currentEvents = [...ALL_EVENTS].sort(() => Math.random() - 0.5).slice(0, 5);
            state.correctOrder = [...state.currentEvents].sort((a, b) => a.year - b.year);
        }

        function renderSlots() {
            const slots = document.querySelectorAll('.slot');
            slots.forEach((s, i) => {
                s.innerHTML = `${i + 1}`;
                s.style.background = "rgba(99,102,241,0.15)";
                s.classList.remove('occupied');
            });
        }

        function renderPool() {
            const pool = document.getElementById('cards-area');
            pool.innerHTML = '';
            state.currentEvents.filter(e => !state.placedEvents.some(pe => pe?.id === e.id)).forEach(e => {
                pool.appendChild(createCard(e));
            });
        }

        function createCard(event, isSmall = false) {
            const cat = CATEGORIES[event.cat];
            const card = document.createElement('div');
            card.className = `event-card ${cat.class} ${state.selectedCard?.id === event.id ? 'selected' : ''}`;
            card.draggable = true;
            card.style.background = "rgba(255,255,255,0.07)";
            card.style.border = "2px solid rgba(255,255,255,0.1)";
            card.style.borderRadius = "16px";
            card.style.padding = "20px 24px";
            card.style.cursor = "grab";
            card.style.display = "flex";
            card.style.alignItems = "center";
            card.style.gap = "16px";
            card.style.minHeight = "90px";
            
            card.innerHTML = `
                <div class="card-emoji">${cat.emoji}</div>
                <div class="card-info">
                    <div class="card-name">${event.name}</div>
                    <div class="card-hint">${isSmall ? event.year : event.hint}</div>
                </div>
            `;
            card.onclick = (e) => {
                e.stopPropagation();
                if (isSmall) {
                    const idx = state.placedEvents.findIndex(pe => pe?.id === event.id);
                    if (idx !== -1) handleSlotClick(idx);
                } else {
                    state.selectedCard = state.selectedCard?.id === event.id ? null : event;
                    renderPool();
                }
            };
            card.ondragstart = (e) => { e.dataTransfer.setData('text/plain', event.id); card.style.opacity = '0.5'; };
            card.ondragend = () => card.style.opacity = '1';
            return card;
        }

        function handleSlotClick(idx) {
            if (state.placedEvents[idx]) {
                state.placedEvents[idx] = null;
                updatePlacements();
            } else if (state.selectedCard) {
                placeEvent(state.selectedCard, idx);
            }
        }

        function placeEvent(event, idx) {
            state.placedEvents[idx] = event;
            state.selectedCard = null;
            updatePlacements();
        }

        function updatePlacements() {
            const slots = document.querySelectorAll('.slot');
            for (let i = 0; i < 5; i++) {
                const ev = state.placedEvents[i];
                const s = slots[i];
                if (ev) {
                    const cat = CATEGORIES[ev.cat];
                    s.innerHTML = `
                        <div style="display:flex; align-items:center; gap:8px; padding:12px; width:100%;">
                          <span style="font-size:1.5rem;">${cat.emoji}</span>
                          <div style="text-align: left;">
                            <div style="font-size:13px; font-weight:700; color:white;">${ev.name}</div>
                            <div style="font-size:11px; color:rgba(255,255,255,0.5);">${ev.hint}</div>
                          </div>
                        </div>
                    `;
                    s.style.background = 'rgba(99,102,241,0.3)';
                    s.classList.add('occupied');
                    s.style.padding = "0";
                } else {
                    s.innerHTML = `${i + 1}`;
                    s.style.background = 'rgba(99,102,241,0.15)';
                    s.classList.remove('occupied');
                    s.style.padding = "16px";
                }
            }
            renderPool();
            document.getElementById('fix-btn').style.display = state.placedEvents.every(e => e !== null) ? 'block' : 'none';
        }

        function startTimer() {
            clearInterval(state.timerInterval);
            const bar = document.getElementById('timer-bar');
            state.timerInterval = setInterval(() => {
                state.timer -= 0.1;
                const pct = Math.max(0, (state.timer / 30) * 100);
                bar.style.width = pct + '%';
                bar.className = pct < 30 ? 'critical' : (pct < 60 ? 'warning' : '');
                if (state.timer <= 0) { clearInterval(state.timerInterval); handleFailure(); }
            }, 100);
        }

        function checkTimeline() {
            clearInterval(state.timerInterval);
            const isCorrect = state.placedEvents.every((ev, i) => ev.id === state.correctOrder[i].id);
            if (isCorrect) handleSuccess(); else handleFailure();
        }

        function handleSuccess() {
            state.score += 150 + (state.streak * 50);
            state.streak++;
            const randomEvent = state.correctOrder[Math.floor(Math.random() * 5)];
            document.getElementById('fact-text').innerText = `Did you know? In ${randomEvent.year}, ${randomEvent.name} changed history. ${randomEvent.hint}`;
            document.getElementById('round-stats').innerText = `+${150 + (state.streak * 50)} Points | Streak: x${state.streak}`;
            document.getElementById('round-overlay').classList.add('active');
            state.round++;
            updateUI();
        }

        function handleFailure() {
            state.lives--;
            state.streak = 0;
            updateUI();
            const hearts = document.querySelectorAll('.heart');
            if (hearts[state.lives]) hearts[state.lives].style.opacity = '0.2';
            if (state.lives <= 0) gameOver(); else setTimeout(startRound, 2000);
        }

        function gameOver() {
            // Issue 5: Stop timer and show screen without auto-restart
            clearInterval(state.timerInterval);
            document.getElementById('over-overlay').classList.add('active');
            document.getElementById('final-score').innerText = state.score.toLocaleString();
        }

        function updateUI() {
            document.getElementById('score-display').innerText = state.score.toLocaleString().padStart(7, '0');
            const badge = document.getElementById('streak-badge');
            badge.innerText = `🔥 x${state.streak}`;
            badge.classList.toggle('active', state.streak >= 2);
        }

        init();
    </script>
</body>
</html>
