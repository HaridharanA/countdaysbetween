---
import Layout from "../layouts/Layout.astro";
---

<Layout 
	title="Page Not Found" 
	description="The page you are looking for does not exist. Return to the CountDaysBetween homepage.">
	<section class="flex flex-col items-center justify-center min-h-[60vh] text-center px-6">
		<div class="prose-content w-full">
			<span class="text-6xl font-bold text-primary mb-4 block">404</span>
			<h1 class="text-4xl md:text-5xl font-semibold tracking-tighter mb-6" style="width:100%; max-width:100%">Page Not Found</h1>
			<p class="text-lg text-body mb-10 mx-auto" style="width:100%; max-width:500px">
				Sorry, we couldn't find the page you're looking for. It might have been moved or deleted.
			</p>
			<a href="/" class="h-12 inline-flex items-center rounded-pill bg-primary px-8 text-on-primary font-medium hover:bg-primary/90 transition-colors">
				Back to Homepage
			</a>
		</div>
	</section>
</Layout>