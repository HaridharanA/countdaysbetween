---
import LayoutPt from "../../layouts/LayoutPt.astro";
import holidaysPt from "../../data/holidays-pt.json";

const holidays2026 = holidaysPt.filter((h) => h.year === 2026);
const holidays2027 = holidaysPt.filter((h) => h.year === 2027);
const holidays2028 = holidaysPt.filter((h) => h.year === 2028);

const pageTitle = "Contagem Regressiva para as Férias e Feriados no Brasil";
const pageDescription = "Acompanhe em tempo real quantos dias faltam para as férias escolares de julho, fim de ano, Carnaval e feriadões no Brasil.";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "name": "Contagem Regressiva para Férias e Feriados Brasil",
      "url": "https://www.countdaysbetween.com/pt/contagem-regressiva/",
      "description": "Acompanhe os dias e horas restantes para as principais férias e feriados no Brasil."
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Início",
          "item": "https://www.countdaysbetween.com/pt/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Contagem Regressiva",
          "item": "https://www.countdaysbetween.com/pt/contagem-regressiva/"
        }
      ]
    }
  ]
};
---

<LayoutPt title={pageTitle} description={pageDescription}>
  <!-- Breadcrumbs -->
  <div class="mb-8 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <nav class="flex items-center gap-2 text-xs font-mono text-mute">
      <a href="/pt/" class="hover:text-ink transition-colors">Início</a>
      <span>/</span>
      <span class="text-ink font-medium">Contagem Regressiva</span>
    </nav>
  </div>

  <!-- Hero Section -->
  <section class="mb-16 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="mb-8" style="width:100%;">
      <div class="inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-semibold text-violet border border-hairline bg-canvas-soft mb-4">
        <span>🏖️</span>
        <span>Contagem em Tempo Real</span>
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-ink mb-4" style="width:100%;">
        Contagem Regressiva para as <span class="text-violet">Férias e Feriados</span>
      </h1>
      <p class="text-base md:text-lg text-body mb-6" style="width:100%; max-width:650px;">
        Descubra exatamente quantos dias, horas e minutos faltam para o seu próximo descanso, férias escolares ou feriado prolongado no Brasil.
      </p>

      <!-- Year Quick Jump Chips -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-mono font-medium uppercase tracking-wider text-mute mr-1">Ir para:</span>
        <a href="#ferias-destaque" class="px-3 py-1.5 rounded-full text-xs font-semibold bg-violet/10 text-violet border border-violet/20 hover:bg-violet/20 transition-colors">
          🏖️ Férias Escolares
        </a>
        <a href="#feriados-2026" class="px-3 py-1.5 rounded-full text-xs font-semibold bg-primary/10 text-primary border border-primary/20 hover:bg-primary/20 transition-colors">
          Feriados 2026 ({holidays2026.length})
        </a>
        <a href="#feriados-2027" class="px-3 py-1.5 rounded-full text-xs font-semibold bg-canvas-soft border border-hairline hover:border-link transition-colors">
          2027
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Vacations Section -->
  <section id="ferias-destaque" class="mb-16 w-full scroll-mt-24" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="p-8 rounded-3xl bg-canvas border border-hairline card-shadow-lg mb-8">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-3xl">🏖️</span>
        <div>
          <h2 class="text-2xl font-bold text-ink">Férias Escolares e Recesso no Brasil</h2>
          <p class="text-xs text-mute">Principais períodos de recesso letivo e descanso corporativo</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="/pt/dias-ate/ferias-de-julho-2026/"
          class="p-5 rounded-2xl bg-canvas-soft border border-hairline hover:border-violet transition-all group card-shadow flex flex-col justify-between"
        >
          <div>
            <span class="text-xs font-mono text-mute">Inverno 2026</span>
            <h3 class="text-lg font-bold text-ink group-hover:text-violet transition-colors mt-1 mb-2">
              Férias de Julho 2026 ❄️
            </h3>
            <p class="text-xs text-body line-clamp-2">Recesso escolar de inverno na maioria das redes de ensino do Brasil.</p>
          </div>
          <span class="text-xs font-semibold text-violet mt-4 flex items-center gap-1">
            Ver Contador ao Vivo →
          </span>
        </a>

        <a
          href="/pt/dias-ate/carnaval-2026/"
          class="p-5 rounded-2xl bg-canvas-soft border border-hairline hover:border-violet transition-all group card-shadow flex flex-col justify-between"
        >
          <div>
            <span class="text-xs font-mono text-mute">Fevereiro 2026</span>
            <h3 class="text-lg font-bold text-ink group-hover:text-violet transition-colors mt-1 mb-2">
              Carnaval 2026 🎭
            </h3>
            <p class="text-xs text-body line-clamp-2">O maior feriadão do ano para descanso e turismo no Brasil.</p>
          </div>
          <span class="text-xs font-semibold text-violet mt-4 flex items-center gap-1">
            Ver Contador ao Vivo →
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- 2026 Brazilian Holidays Grid -->
  <section id="feriados-2026" class="mb-20 w-full scroll-mt-24" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="flex items-center justify-between mb-8 pb-4 border-b border-hairline">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-ink">Feriados 2026 no Brasil</h2>
        <p class="text-sm text-mute mt-1">Datas oficiais e contagem regressiva</p>
      </div>
      <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-bold font-mono text-primary">2026</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      {holidays2026.map((h) => (
        <a
          href={`/pt/dias-ate/${h.slug}/`}
          class="flex items-center gap-3 p-4 rounded-2xl bg-canvas border border-hairline hover:border-link transition-all group card-shadow"
        >
          <span class="text-2xl flex-shrink-0">{h.icon}</span>
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold text-sm text-ink group-hover:text-link transition-colors truncate">{h.holidayName}</h3>
            <p class="text-xs text-mute truncate">{h.dayOfWeek}, {h.date}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</LayoutPt>
