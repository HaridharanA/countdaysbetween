---
import Layout from "../layouts/Layout.astro";

const pageTitle = "Exact Age Calculator | Calculate Age in Years, Months, Days & Seconds";
const pageDescription = "Calculate your exact chronological age down to the second. Find total days lived, countdown to your next birthday, zodiac sign, and 10,000 days milestone.";
---

<Layout title={pageTitle} description={pageDescription}>
  <section class="mb-12 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <a href="/" class="text-sm text-link hover:underline mb-6 inline-block">← Back to home</a>
    <div class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold text-rose-500 border border-rose-200 dark:border-rose-900/50 bg-rose-50/50 dark:bg-rose-950/20 mb-3">
      <span>🎂</span>
      <span>Life & Chronological Age</span>
    </div>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-ink mb-4" style="width:100%;">
      Exact Age <span class="text-rose-500">Calculator.</span>
    </h1>
    <p class="text-lg text-body mb-6" style="width:100%; max-width:600px;">
      Discover your precise chronological age in years, months, weeks, days, hours, and live ticking seconds.
    </p>
  </section>

  <!-- Interactive Age Calculator Form -->
  <section class="mb-16 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="p-8 md:p-10 rounded-3xl bg-canvas border border-hairline card-shadow-lg">
      <form id="age-calc-form" class="space-y-6" onsubmit="event.preventDefault();">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="age-birth-date" class="block text-xs font-semibold uppercase tracking-wider text-mute mb-2">
              Date of Birth 🎂
            </label>
            <input
              type="date"
              id="age-birth-date"
              required
              class="w-full h-12 px-4 rounded-xl border border-hairline bg-canvas text-ink text-sm outline-none focus:border-rose-500 transition-colors shadow-sm"
            />
          </div>

          <div>
            <label for="age-target-date" class="block text-xs font-semibold uppercase tracking-wider text-mute mb-2">
              Age at Date 📅
            </label>
            <input
              type="date"
              id="age-target-date"
              required
              class="w-full h-12 px-4 rounded-xl border border-hairline bg-canvas text-ink text-sm outline-none focus:border-rose-500 transition-colors shadow-sm"
            />
          </div>
        </div>

        <button
          type="submit"
          id="btn-calculate-age"
          class="w-full h-14 rounded-full bg-rose-500 text-white font-bold text-base hover:scale-[1.01] active:scale-[0.99] transition-all shadow-lg shadow-rose-500/20 flex items-center justify-center gap-2"
        >
          <span>Calculate Exact Age & Milestones ✨</span>
        </button>
      </form>

      <!-- Live Age Output Dashboard -->
      <div id="age-results-box" class="hidden mt-8 pt-8 border-t border-hairline animate-in fade-in duration-500">
        <!-- Main Primary Age -->
        <div class="text-center mb-8">
          <span class="text-xs uppercase font-mono tracking-widest text-mute block mb-2">Your Exact Chronological Age</span>
          <div id="primary-age-str" class="text-3xl md:text-5xl font-black text-ink tracking-tight mb-2">
            --
          </div>
          <p id="next-bday-countdown-str" class="text-sm font-semibold text-rose-500">
            --
          </p>
        </div>

        <!-- Metric Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
          <div class="p-4 rounded-2xl bg-canvas-soft border border-hairline text-center">
            <span class="text-[11px] uppercase font-mono text-mute block mb-1">Total Days</span>
            <span id="stat-total-days" class="text-2xl sm:text-3xl font-black text-ink tabular-nums">0</span>
          </div>
          <div class="p-4 rounded-2xl bg-canvas-soft border border-hairline text-center">
            <span class="text-[11px] uppercase font-mono text-mute block mb-1">Total Weeks</span>
            <span id="stat-total-weeks" class="text-2xl sm:text-3xl font-black text-ink tabular-nums">0</span>
          </div>
          <div class="p-4 rounded-2xl bg-canvas-soft border border-hairline text-center">
            <span class="text-[11px] uppercase font-mono text-mute block mb-1">Total Hours</span>
            <span id="stat-total-hours" class="text-2xl sm:text-3xl font-black text-ink tabular-nums">0</span>
          </div>
          <div class="p-4 rounded-2xl bg-canvas-soft border border-hairline text-center">
            <span class="text-[11px] uppercase font-mono text-mute block mb-1">Seconds Alive</span>
            <span id="stat-live-seconds" class="text-2xl sm:text-3xl font-black text-rose-500 tabular-nums">0</span>
          </div>
        </div>

        <!-- 10,000-Day Milestone & Astrological Traits -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-2xl bg-gradient-to-br from-rose-50 to-orange-50 dark:from-rose-950/30 dark:to-orange-950/20 border border-rose-100 dark:border-rose-900/30">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xl">🏆</span>
              <h4 class="font-bold text-ink text-sm">Next Big Milestone</h4>
            </div>
            <p id="milestone-headline" class="text-sm font-semibold text-rose-600 dark:text-rose-300 mb-1">
              --
            </p>
            <p id="milestone-sub" class="text-xs text-body">
              --
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-canvas-soft border border-hairline">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-xl">⭐</span>
              <h4 class="font-bold text-ink text-sm">Astrological & Cosmic Sign</h4>
            </div>
            <p id="astrology-headline" class="text-sm font-semibold text-ink mb-1">
              --
            </p>
            <p id="astrology-sub" class="text-xs text-mute">
              --
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Informational SEO Guide -->
  <section class="mb-24 w-full prose dark:prose-invert" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="prose-content w-full" style="width:100%;">
      <h2 class="text-3xl font-bold mb-6" style="width:100%;">How Chronological Age Calculation Works</h2>
      <p style="width:100%;">
        Chronological age is the exact amount of time that has elapsed from an individual's date of birth to a specific date. While humans typically refer to their age in completed whole years (e.g., "I am 28 years old"), precise date math requires accounting for month lengths (ranging from 28 to 31 days) and leap years with February 29th.
      </p>

      <h3 class="text-2xl font-semibold mt-8 mb-4" style="width:100%;">Major Life Age Milestones</h3>
      <ul class="list-disc pl-6 space-y-2" style="width:100%;">
        <li><strong>10,000 Days Alive:</strong> Typically occurs around age 27 years and 4 months. Reaching 10,000 days is one of the most celebrated personal milestones on social media.</li>
        <li><strong>20,000 Days Alive:</strong> Reached around age 54 years and 9 months.</li>
        <li><strong>1 Billion Seconds:</strong> Humans celebrate their one-billionth second alive around age 31 years, 8 months, and 19 days.</li>
      </ul>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="mb-24 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <h2 class="text-3xl font-bold mb-8 text-center text-ink" style="width:100%;">Frequently Asked Questions</h2>
    <div class="space-y-4" style="width:100%;">
      <details class="faq-accordion group p-6 rounded-2xl bg-canvas border border-hairline card-shadow cursor-pointer">
        <summary class="flex items-center justify-between font-semibold text-ink list-none">
          <span class="text-lg">How is exact age in years, months, and days calculated?</span>
          <span class="text-link group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="text-body leading-relaxed mt-4 pt-4 border-t border-hairline text-sm">
          The calculator first determines total whole completed years. It then computes remaining full calendar months, followed by the remaining days, while factoring in the precise days in each intervening month.
        </p>
      </details>

      <details class="faq-accordion group p-6 rounded-2xl bg-canvas border border-hairline card-shadow cursor-pointer">
        <summary class="flex items-center justify-between font-semibold text-ink list-none">
          <span class="text-lg">When will I reach 10,000 days alive?</span>
          <span class="text-link group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="text-body leading-relaxed mt-4 pt-4 border-t border-hairline text-sm">
          Enter your date of birth in the calculator above. The milestone card will instantly calculate the exact future date of your 10,000th day on Earth and the days remaining.
        </p>
      </details>
    </div>
  </section>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebApplication",
        "name": "Exact Age Calculator",
        "url": "https://www.countdaysbetween.com/age-calculator",
        "applicationCategory": "UtilityApplication",
        "operatingSystem": "All",
        "description": pageDescription
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How is exact age in years, months, and days calculated?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The calculator determines completed whole years, full calendar months, and exact remaining days."
            }
          }
        ]
      }
    ]
  })} />
</Layout>

<script>
  function initAgeCalculator() {
    const birthInput = document.getElementById('age-birth-date') as HTMLInputElement;
    const targetInput = document.getElementById('age-target-date') as HTMLInputElement;
    const calcBtn = document.getElementById('btn-calculate-age');
    const resultsBox = document.getElementById('age-results-box');

    const primaryAgeStr = document.getElementById('primary-age-str');
    const nextBdayStr = document.getElementById('next-bday-countdown-str');
    const statDays = document.getElementById('stat-total-days');
    const statWeeks = document.getElementById('stat-total-weeks');
    const statHours = document.getElementById('stat-total-hours');
    const statSecs = document.getElementById('stat-live-seconds');
    const milestoneHead = document.getElementById('milestone-headline');
    const milestoneSub = document.getElementById('milestone-sub');
    const astroHead = document.getElementById('astrology-headline');
    const astroSub = document.getElementById('astrology-sub');

    let timerInterval: number | null = null;

    // Default target date to today, default birth date to 25 years ago
    if (targetInput && !targetInput.value) {
      targetInput.value = new Date().toISOString().split('T')[0];
    }
    if (birthInput && !birthInput.value) {
      const defaultBirth = new Date();
      defaultBirth.setFullYear(defaultBirth.getFullYear() - 25);
      birthInput.value = defaultBirth.toISOString().split('T')[0];
    }

    function getZodiac(month: number, day: number) {
      const signs = [
        { name: "Capricorn ♑", start: [1, 1], end: [1, 19] },
        { name: "Aquarius ♒", start: [1, 20], end: [2, 18] },
        { name: "Pisces ♓", start: [2, 19], end: [3, 20] },
        { name: "Aries ♈", start: [3, 21], end: [4, 19] },
        { name: "Taurus ♉", start: [4, 20], end: [5, 20] },
        { name: "Gemini ♊", start: [5, 21], end: [6, 20] },
        { name: "Cancer ♋", start: [6, 21], end: [7, 22] },
        { name: "Leo ♌", start: [7, 23], end: [8, 22] },
        { name: "Virgo ♍", start: [8, 23], end: [9, 22] },
        { name: "Libra ♎", start: [9, 23], end: [10, 22] },
        { name: "Scorpio ♏", start: [10, 23], end: [11, 21] },
        { name: "Sagittarius ♐", start: [11, 22], end: [12, 21] },
        { name: "Capricorn ♑", start: [12, 22], end: [12, 31] }
      ];
      for (const s of signs) {
        if (
          (month === s.start[0] && day >= s.start[1]) ||
          (month === s.end[0] && day <= s.end[1])
        ) {
          return s.name;
        }
      }
      return "Capricorn ♑";
    }

    function getChineseZodiac(year: number) {
      const animals = ["Rat 🐀", "Ox 🐂", "Tiger 🐅", "Rabbit 🐇", "Dragon 🐉", "Snake 🐍", "Horse 🐎", "Goat 🐐", "Monkey 🐒", "Rooster 🐓", "Dog 🐕", "Pig 🐖"];
      return animals[(year - 4) % 12];
    }

    function calculateAge() {
      if (!birthInput || !birthInput.value || !targetInput || !targetInput.value) return;

      const birth = new Date(birthInput.value + "T00:00:00");
      const target = new Date(targetInput.value + "T00:00:00");

      const diffMs = target.getTime() - birth.getTime();
      if (diffMs < 0) {
        alert("Target date must be after your birth date!");
        return;
      }

      // Exact years, months, days
      let years = target.getFullYear() - birth.getFullYear();
      let months = target.getMonth() - birth.getMonth();
      let days = target.getDate() - birth.getDate();

      if (days < 0) {
        months--;
        const prevMonth = new Date(target.getFullYear(), target.getMonth(), 0);
        days += prevMonth.getDate();
      }
      if (months < 0) {
        years--;
        months += 12;
      }

      const totalDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
      const totalWeeks = Math.floor(totalDays / 7);
      const totalHours = Math.floor(diffMs / (1000 * 60 * 60));

      if (primaryAgeStr) {
        primaryAgeStr.innerText = `${years} Years, ${months} Months, ${days} Days`;
      }

      // Next Birthday
      const nextBday = new Date(target.getFullYear(), birth.getMonth(), birth.getDate());
      if (nextBday < target) {
        nextBday.setFullYear(target.getFullYear() + 1);
      }
      const daysToBday = Math.ceil((nextBday.getTime() - target.getTime()) / (1000 * 60 * 60 * 24));
      if (nextBdayCountdownStr) {
        nextBdayCountdownStr.innerText = daysToBday === 0 
          ? "🎉 Today is your Birthday! Happy Birthday!" 
          : `🎉 ${daysToBday} days until your next birthday (${nextBday.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })})`;
      }

      if (statDays) statDays.innerText = totalDays.toLocaleString();
      if (statWeeks) statWeeks.innerText = totalWeeks.toLocaleString();
      if (statHours) statHours.innerText = totalHours.toLocaleString();

      // Milestone
      const milestones = [1000, 2500, 5000, 7500, 10000, 15000, 20000, 25000, 30000];
      const nextMilestone = milestones.find(m => m > totalDays) || (Math.ceil(totalDays / 5000) * 5000);
      const milestoneDate = new Date(birth.getTime() + (nextMilestone * 24 * 60 * 60 * 1000));
      const daysLeftMilestone = nextMilestone - totalDays;

      if (milestoneHead && milestoneSub) {
        milestoneHead.innerText = `${nextMilestone.toLocaleString()}th Day on Earth`;
        milestoneSub.innerText = `Falls on ${milestoneDate.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' })} (in ${daysLeftMilestone.toLocaleString()} days)`;
      }

      // Astrology
      const zSign = getZodiac(birth.getMonth() + 1, birth.getDate());
      const cSign = getChineseZodiac(birth.getFullYear());
      if (astroHead && astroSub) {
        astroHead.innerText = `${zSign}`;
        astroSub.innerText = `Chinese Zodiac: ${cSign}`;
      }

      // Live ticking seconds
      if (timerInterval) clearInterval(timerInterval);
      const updateLiveSecs = () => {
        const nowSec = Math.floor((new Date().getTime() - birth.getTime()) / 1000);
        if (statSecs) statSecs.innerText = nowSec.toLocaleString();
      };
      updateLiveSecs();
      timerInterval = window.setInterval(updateLiveSecs, 1000);

      resultsBox?.classList.remove('hidden');
    }

    [birthInput, targetInput].forEach(el => {
      el?.addEventListener('change', calculateAge);
    });

    calculateAge();
  }

  initAgeCalculator();
  document.addEventListener('astro:page-load', initAgeCalculator);
</script>
