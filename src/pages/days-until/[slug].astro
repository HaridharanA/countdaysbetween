---
import Layout from "../../layouts/Layout.astro";
import CountdownHero from "../../components/CountdownHero.astro";
import DayBreakdownTable from "../../components/DayBreakdownTable.astro";
import RelatedDates from "../../components/RelatedDates.astro";
import holidays from "../../data/holidays.json";

export async function getStaticPaths() {
  return holidays.map((holiday) => ({
    params: { slug: holiday.slug },
    props: { holiday }
  }));
}

const { holiday } = Astro.props;

const pageTitle = `Days Until ${holiday.name} | Exact Countdown & Date Math`;
const pageDescription = `Find out exactly how many days, hours, and business days until ${holiday.name} (${holiday.dayOfWeek}, ${holiday.date}). Free live countdown timer and complete calendar breakdown.`;

const formattedTargetDate = new Date(holiday.date + "T00:00:00Z").toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC"
});
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Breadcrumbs -->
  <div class="mb-8 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <nav class="flex items-center gap-2 text-xs font-mono text-mute">
      <a href="/" class="hover:text-ink transition-colors">Home</a>
      <span>/</span>
      <a href="/countdown" class="hover:text-ink transition-colors">Countdown</a>
      <span>/</span>
      <span class="text-ink font-medium truncate">{holiday.name}</span>
    </nav>
  </div>

  <!-- Live Countdown Hero -->
  <CountdownHero
    eventName={holiday.name}
    targetDate={holiday.date}
    dayOfWeek={holiday.dayOfWeek}
    icon={holiday.icon}
    category={holiday.category}
  />

  <!-- Stats & Business Days Breakdown -->
  <DayBreakdownTable
    targetDate={holiday.date}
    eventName={holiday.name}
    dayOfWeek={holiday.dayOfWeek}
  />

  <!-- 5-Year Past & Future Schedule Table -->
  <section class="mb-16 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-6 text-ink" style="width:100%;">
      {holiday.holidayName} Dates: 5-Year Schedule (2024–2028)
    </h2>
    <p class="text-sm text-body mb-6" style="width:100%;">
      Compare the date and day of the week for {holiday.holidayName} across recent and upcoming calendar years:
    </p>

    <div class="overflow-hidden rounded-2xl border border-hairline bg-canvas card-shadow">
      <table class="w-full text-left text-sm" style="width:100%;">
        <thead class="bg-canvas-soft border-b border-hairline text-xs uppercase font-mono text-mute">
          <tr>
            <th class="px-6 py-4">Year</th>
            <th class="px-6 py-4">Date</th>
            <th class="px-6 py-4">Day of Week</th>
            <th class="px-6 py-4 text-right">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline">
          {holiday.pastFutureDates.map((item) => {
            const isCurrent = item.year === holiday.year;
            return (
              <tr class={isCurrent ? "bg-primary/5 font-semibold" : ""}>
                <td class="px-6 py-4 font-medium text-ink">
                  {item.year} {isCurrent && <span class="ml-2 inline-block rounded-full bg-primary/10 px-2 py-0.5 text-xs text-primary font-mono">Current</span>}
                </td>
                <td class="px-6 py-4 text-body font-mono">{item.date}</td>
                <td class="px-6 py-4 text-body">{item.dayOfWeek}</td>
                <td class="px-6 py-4 text-right">
                  {item.year === holiday.year ? (
                    <span class="text-xs font-semibold text-link">Viewing</span>
                  ) : (
                    <a
                      href={`/days-until/${holiday.holidayKey}-${item.year}/`}
                      class="text-xs text-link hover:underline font-medium"
                    >
                      Countdown →
                    </a>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Unique Context & Background Section -->
  <section class="mb-16 w-full prose dark:prose-invert" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="prose-content w-full" style="width:100%;">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-6 text-ink" style="width:100%;">
        About {holiday.name}
      </h2>
      {holiday.description.map((paragraph) => (
        <p class="text-body leading-relaxed mb-4" style="width:100%; max-width:800px;">
          {paragraph}
        </p>
      ))}
    </div>
  </section>

  <!-- Interactive Date Math Quick Links -->
  <section class="mb-16 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <div class="p-8 rounded-3xl bg-canvas-soft border border-hairline flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="text-left" style="width:100%;">
        <h3 class="text-xl font-bold text-ink mb-1">Need a custom date calculation?</h3>
        <p class="text-sm text-body">Calculate exact days, working business days, or weeks between any two custom dates.</p>
      </div>
      <a
        href="/#tool"
        class="flex-shrink-0 h-12 flex items-center rounded-pill bg-primary px-8 text-on-primary font-medium hover:scale-105 transition-all shadow-md"
      >
        Open Calculator
      </a>
    </div>
  </section>

  <!-- Contextual FAQ Section -->
  <section class="mb-16 w-full" style="width:100%; max-width:800px; margin-left:auto; margin-right:auto;">
    <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-8 text-ink" style="width:100%;">
      Frequently Asked Questions
    </h2>
    <div class="space-y-6" style="width:100%;">
      {holiday.faqs.map((faq) => (
        <div class="p-6 rounded-2xl bg-canvas border border-hairline card-shadow">
          <h3 class="text-lg font-semibold text-ink mb-2" style="width:100%;">{faq.question}</h3>
          <p class="text-sm text-body leading-relaxed" style="width:100%;">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Internal Linking / Related Holidays -->
  <RelatedDates
    currentSlug={holiday.slug}
    holidayKey={holiday.holidayKey}
    year={holiday.year}
    category={holiday.category}
  />

  <!-- FAQPage Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": holiday.faqs.map((faq) => ({
      "@type": "Question",
      "name": faq.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.answer
      }
    }))
  })} />
</Layout>
