---
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Calculate days between dates easily." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-FKG8KSWV3M"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());
		  gtag('config', 'G-FKG8KSWV3M');
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="CountDays" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		
		<title>{title} | Days Between Dates</title>
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/favicon.svg', Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL('/favicon.svg', Astro.url)} />

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap" rel="stylesheet">
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
		
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
	</head>
	<body class="selection:bg-primary selection:text-on-primary min-h-screen bg-canvas-soft text-ink flex flex-col">
		<div class="fixed inset-0 -z-10 overflow-hidden">
			<div class="mesh-gradient absolute -top-[30%] left-0 right-0 h-[70%]"></div>
		</div>
		
		<nav class="sticky top-0 z-50 h-16 border-b border-hairline bg-canvas/80 backdrop-blur-md">
			<div class="mx-auto flex h-full max-w-[1400px] items-center justify-between px-6 md:px-8">
				<a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
					<span class="text-xl">CountDays</span>
				</a>
				
				<div class="flex items-center gap-6">
					<div class="hidden items-center gap-6 md:flex">
						<a href="/business-days" class="text-sm text-body hover:text-ink">Business Days</a>
						<a href="/countdown" class="text-sm text-body hover:text-ink">Countdown</a>
					</div>
					<div class="h-4 w-px bg-hairline hidden md:block"></div>
					
					<button id="theme-toggle" class="flex h-8 w-8 items-center justify-center rounded-md border border-hairline bg-canvas hover:bg-canvas-soft-2 transition-colors" aria-label="Toggle Dark Mode">
						<svg id="sun-icon" class="hidden dark:block" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
						<svg id="moon-icon" class="block dark:hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
					</button>

					<a href="#" class="hidden md:block rounded-sm bg-primary px-3 py-1 text-sm font-medium text-on-primary">Sign Up</a>
				</div>
			</div>
		</nav>

		<main class="w-full max-w-[1400px] mx-auto px-6 md:px-8 pt-8 pb-16 flex-grow overflow-x-hidden">
			<slot />
		</main>

		<footer class="border-t border-hairline bg-canvas py-16 mt-24">
			<div class="mx-auto max-w-[1400px] px-6 md:px-8">
				<div class="grid grid-cols-2 gap-8 md:grid-cols-4">
					<div class="flex flex-col gap-3">
						<span class="font-mono text-xs font-medium uppercase tracking-wider text-mute">Product</span>
						<a href="/" class="text-sm text-body hover:text-ink">Calculator</a>
						<a href="/timeline-wars" class="text-sm text-body hover:text-ink">Timeline Wars 🎮</a>
						<a href="/business-days" class="text-sm text-body hover:text-ink">Business Days</a>
						<a href="/countdown" class="text-sm text-body hover:text-ink">Countdown</a>
					</div>
					<div class="flex flex-col gap-3">
						<span class="font-mono text-xs font-medium uppercase tracking-wider text-mute">Resources</span>
						<a href="#" class="text-sm text-body hover:text-ink">Blog</a>
						<a href="#" class="text-sm text-body hover:text-ink">Documentation</a>
					</div>
					<div class="flex flex-col gap-3">
						<span class="font-mono text-xs font-medium uppercase tracking-wider text-mute">Company</span>
						<a href="/about" class="text-sm text-body hover:text-ink">About</a>
						<a href="/privacy-policy" class="text-sm text-body hover:text-ink">Privacy</a>
						<a href="/terms" class="text-sm text-body hover:text-ink">Terms</a>
						<a href="/contact" class="text-sm text-body hover:text-ink">Contact</a>
					</div>
					<div class="flex flex-col gap-3">
						<span class="font-mono text-xs font-medium uppercase tracking-wider text-mute">Subscribe</span>
						<p class="text-sm text-mute">Get updates on new tools.</p>
					</div>
				</div>
				<div class="mt-8 pt-8 border-t border-hairline flex flex-col md:flex-row justify-between items-center gap-4">
					<p class="text-xs text-mute">© 2026 Count Days Between. All rights reserved.</p>
					<div class="flex gap-6">
						<!-- Social Icons Placeholder -->
					</div>
				</div>
			</div>
		</footer>

		<script>
			const themeToggle = document.getElementById('theme-toggle');
			themeToggle?.addEventListener('click', () => {
				const element = document.documentElement;
				element.classList.toggle('dark');
				const isDark = element.classList.contains('dark');
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
			});
		</script>
	</body>
</html>
